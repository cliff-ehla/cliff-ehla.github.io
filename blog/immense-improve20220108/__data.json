{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"id":1,"attributes":2},218,{"title":3,"excerpt":4,"content":5,"slug":6,"createdAt":7,"updatedAt":7,"author":8,"categories":9,"tags":17,"image":24,"related_posts":25},"內外防護 擊退新冠病毒",null,"\n\n許多新冠肺炎患者康復後，仍深受後遺症所苦😣，主要因為感染期間，病毒或會攻擊肺部組織，導致肺纖維化，進一步影響呼吸功能；也影響其他器官系統，造成心血管、神經、免疫、凝血、腦部等器官系統受損。\n\n較常見的後遺症有肌肉無力、呼吸困難、慢性疲勞、咳嗽胸痛、胸悶、關節疼痛、失眠、焦慮、注意力不集中、記憶力下降、行走困難、吞嚥困難、情緒低落或認知功能下降等，這些後遺症被統稱為「新冠肺炎後綜合症」（Post COVID-19 syndrome）。\n\n在Omicron＋Delta＋流感，還有新冠新變種株IHU在非洲及歐洲出現， 提升自身免疫力刻不容緩💪🏻！\n\n💛維他命C -- 可增強身體免疫力，加速調動白血球，並維護黏膜組織健康。\n\n💜紫錐花 -- 自1920年代已獲醫學界採用，可短時間迅速提升免疫力，並加速身體復元。配合維他命C，免疫力可增強達86％！😱\n\n💚乳酸菌 -- 70%免疫細胞集中在腸道，故此確保腸道菌群平衡非常重要。購買乳酸菌時，必須選取經科研證實有效的菌株，益菌可直達腸道並保持活性，繼續在腸道繁殖，方能為身體構建最強的免疫防線。\n\n💙大蒜 -- 蒜氨酸及蒜素可強力抗菌，同時提升腸道免疫力\n\n除了內部提升防護力，外部防護也同樣重要。保持手口衛生😷，確保空氣流通，使用有效的空氣清新機，定期淨化室內空氣，防疫就更加到位！🌈","immense-improve20220108","2022-01-08T00:00:00.000Z",{"data":4},{"data":10},[11],{"id":12,"attributes":13},1,{"slug":14,"name":15,"description":4,"createdAt":16,"updatedAt":16},"nutrition","營養隨筆","2023-02-12T02:39:02.691Z",{"data":18},[19],{"id":20,"attributes":21},285,{"name":22,"createdAt":23,"updatedAt":23},"抗疫","2023-02-12T03:32:01.422Z",{"data":4},{"data":26},[27],{"id":28,"attributes":29},257,{"title":30,"excerpt":4,"content":31,"slug":32,"createdAt":33,"updatedAt":34},"談「痰」健康","\u003Cp style=\"margin-left:0px;\"\u003E談「痰」健康\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E痰是呼吸道的分泌物，主要源自支氣管黏膜的黏液腺，有保護與潤滑咽喉，並黏附有害物質的作用。\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E正常情況下分泌量較少，毋需排出；惟當支氣管黏膜尤其是黏液腺受刺激後，黏液分泌增加，與吸入的顆粒（如油煙、塵埃），以及不同類型的病原微生物（如病毒、細菌、支原體）結合一起，形成痰液。\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E早上起來，常感有痰卡著，可能與4種疾病相關：\u003C\u002Fp\u003E\u003Col\u003E\u003Cli\u003E鼻炎或鼻竇炎 — 鼻腔、鼻竇內的發炎性分泌物倒流入咽喉，產生痰液。\u003C\u002Fli\u003E\u003Cli\u003E慢性咽喉炎 — 炎症感染引發大量分泌物滲出，導致喉嚨乾涸或痕癢，並往往感到喉嚨有異物發堵。\u003C\u002Fli\u003E\u003Cli\u003E肺氣管疾病 — 患有慢性支氣管炎、支氣管擴張、肺炎等疾病，通常伴隨咳嗽，導致肺氣管內的分泌物通過咳嗽進入咽喉形成痰液；如局部感染明顯，多有黃膿痰。\u003C\u002Fli\u003E\u003Cli\u003E胃酸倒流 — 胃酸等消化液反流至咽喉，刺激咽喉黏膜，導致咽喉黏膜慢性炎症，形成痰液。\u003C\u002Fli\u003E\u003C\u002Fol\u003E\u003Cp style=\"margin-left:0px;\"\u003E如何清咽利痰？\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E建議增加攝取膳食纖維，多吃全穀類、豆類、水果和蔬菜，有助促進腸道蠕動，利於濕氣排出，化解體內的痰液，從而維持呼吸系統健康。\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E所謂「藥食同源」，傳統漢方「人參百合湯」可以補氣健脾；搭配清熱利咽止咳的羅漢果、雪梨和茯苓，更能養生潤肺，生津化痰。\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E喝水當然也十分重要。建議按每公斤體重 x 0.04公升計算每天喝水量，例如體重60公升的人士，一天應喝2.4公升水。充足的水份攝入有助稀釋痰液，對維持健康也至關重要。\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E太極、八段錦、散步等輕度有氧運動，每天堅持至少30分鐘，有助增強肺部功能，幫助身體更有效地清除痰液。\u003C\u002Fp\u003E\u003Cp style=\"margin-left:0px;\"\u003E此外，腹式呼吸有助排出氣管中的痰（請按https:\u002F\u002Fwww.facebook.com\u002Fshare\u002Fv\u002FZNAquo6tfMasXMjb\u002F?mibextid=oFDknk ，觀看運動教練Joyce示範腹式呼吸）。\u003C\u002Fp\u003E","phlegm-240327","2024-04-01T07:24:05.419Z","2024-04-01T07:26:15.121Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/posts?populate[author]=true&populate[categories]=true&populate[tags]=true&populate[image]=true&populate[related_posts]=true&filters[slug][$eq]=immense-improve20220108"],"params":["slug"]}}]}