{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"id":1,"attributes":2},215,{"title":3,"excerpt":4,"content":5,"slug":6,"createdAt":7,"updatedAt":7,"author":8,"categories":9,"tags":17,"image":24,"related_posts":25},"你，飲水了嗎？",null,"\n\n你，飲水了嗎？\n水份佔了人體的60%-70%，對身體舉足輕重。在運動過程中，水份擔任著調節體溫，輸送營養及氧份，帶走血液中廢物的作用。當運動強度越高，運動時間越長，出汗越多，水份及電解質流失就越多。\n\n當水份流失超過體重的2%，便會影響運動表現；當水份流失超過體重的5%，便有機會出現熱抽筋甚至熱衰竭以致中暑🥵。故此運動過程中必須適時補充水份呢！有關熱抽筋、熱昏厥、熱衰竭及中暑的徵狀，請看附圖。\n\n運動時的水份攝入可以分為3階段：\u003Cbr\u003E\n1️⃣運動前：運動前2小時開始逐步補充水份。較簡單地判斷身體是否水份充足，可以觀察尿液顏色。若顏色較深（忌廉黃色），顯示水份未夠；水份較充足時，尿液該是淺黃色😉。\u003Cbr\u003E\n2️⃣運動中：根據汗液流失量而補充水份，較佳的補充水份方法是分段地補充 -- 每15至20分鐘補充100至200毫升水份。\u003Cbr\u003E\n3️⃣運動後：此階段是補充失去的水份和電解質。同樣也可以根據尿液顏色，判斷水份是否充足呢！\n\n很多朋友喜歡運動後喝電解質飲料以補充水份，但謹記要小心選擇，避免糖份過高，得不償失呢！🙈一般性的低中強度運動，未必需要喝電解質飲料。只有在持續運動1小時以上並有明顯的喘氣與流汗，才有可能需要補充電解質飲料，以補充電解質的流失💪🏻。\n關於補充水份的詳盡解說，歡迎大家觀看＜營一世＞短片 https:\u002F\u002Ffb.watch\u002F7gOiPJUvag\u002F 。\n\n\u003Cimg src=\"{assetsBasePath}\u002F1.jpg\" alt=\"img\"\u002F\u003E\n\n\n","drink-water-2109","2021-08-13T00:00:00.000Z",{"data":4},{"data":10},[11],{"id":12,"attributes":13},3,{"slug":14,"name":15,"description":4,"createdAt":16,"updatedAt":16},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"data":18},[19],{"id":20,"attributes":21},267,{"name":22,"createdAt":23,"updatedAt":23},"飲水,運動補水,中暑,電解質","2023-02-12T03:32:01.413Z",{"data":4},{"data":26},[]],"uses":{"dependencies":["http://127.0.0.1:1337/api/posts?populate[author]=true&populate[categories]=true&populate[tags]=true&populate[image]=true&populate[related_posts]=true&filters[slug][$eq]=drink-water-2109"],"params":["slug"]}}]}