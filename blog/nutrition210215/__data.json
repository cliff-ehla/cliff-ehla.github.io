{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"id":1,"attributes":2},200,{"title":3,"excerpt":4,"content":5,"slug":6,"createdAt":7,"updatedAt":7,"author":8,"categories":9,"tags":17,"image":39,"related_posts":40},"眉精眼企",null,"\n\n牛年伊始，Empower謹祝大家體健身強，由內至外眉精眼企，營一世，fit一世！💪🏻💪🏻\n\n新年假期，看手機、平板、電腦或電視的時間大增。盯著螢幕時，眨眼的頻率會由正常每分鐘約12下減少至一半，導致眼周肌肉緊繃、血液循環不佳，引起眼睛疲勞及身體不適，被稱為「電腦視覺症候群」。電腦視覺症候群並非疾病，而是眼睛病變的警號；若長期不理會，嚴重者可導致失明。\n電子螢幕散發的藍光屬於高能量光源，波長接近紫外線。長時間注視螢幕，容易導致黃斑中的葉黃素消耗殆盡，造成：\u003Cbr\u003E\n😨中心視力模糊\u003Cbr\u003E\n😨無法分辨顏色\u003Cbr\u003E\n😨視覺扭曲\u003Cbr\u003E\n黃斑病變一旦發生就很難逆轉，所以預防很重要，必須堅持補充葉黃素！\u003Cbr\u003E\n除了葉黃素外，花青素亦十分重要。護眼往往想起藍莓（blueberry），但原來藍莓多用於果醬或食品添加劑；真正用於改善眼睛健康的是歐越莓（bilberry），又名越橘或山桑子，原產於北歐、美國北方及加拿大，較藍莓含更多花青素。歐越莓改善的不只視力，更重要是改善眼部的微循環，故此對預防青光眼也有幫助👍🏻。\n完整且足夠的護眼營養素，單靠天然食物補充實在困難，例如1隻雞蛋只含0.3毫克的葉黃素。建議大家選擇補充品時，除了注意原材料是否天然有機外，還需要葉黃素、花青素與Omega-3互相搭配，才能高效延緩眼睛老化，建構全方位的護眼機制，做個👀眉精眼企的消費者！","nutrition210215","2021-02-15T00:00:00.000Z",{"data":4},{"data":10},[11],{"id":12,"attributes":13},1,{"slug":14,"name":15,"description":4,"createdAt":16,"updatedAt":16},"nutrition","營養隨筆","2023-02-12T02:39:02.691Z",{"data":18},[19,24,29,34],{"id":20,"attributes":21},220,{"name":22,"createdAt":23,"updatedAt":23},"花青素","2023-02-12T03:32:01.393Z",{"id":25,"attributes":26},221,{"name":27,"createdAt":28,"updatedAt":28},"葉黃素","2023-02-12T03:32:01.394Z",{"id":30,"attributes":31},140,{"name":32,"createdAt":33,"updatedAt":33},"眼睛","2023-02-12T03:32:01.349Z",{"id":35,"attributes":36},169,{"name":37,"createdAt":38,"updatedAt":38},"奧米加三","2023-02-12T03:32:01.366Z",{"data":4},{"data":41},[]],"uses":{"dependencies":["http://127.0.0.1:1337/api/posts?populate[author]=true&populate[categories]=true&populate[tags]=true&populate[image]=true&populate[related_posts]=true&filters[slug][$eq]=nutrition210215"],"params":["slug"]}}]}