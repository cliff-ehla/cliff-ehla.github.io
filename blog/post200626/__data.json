{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"id":1,"attributes":2},177,{"title":3,"excerpt":4,"content":5,"slug":6,"createdAt":7,"updatedAt":7,"author":8,"categories":9,"tags":17,"image":54,"related_posts":55},"滋養眼睛 拒絕乾眼症",null,"\n\n香港人乾眼症狀十分普遍。奧比斯聯同香港眼科學會及香港防盲協會於2018年進行的調查顯示，30%受訪者被界定為有嚴重乾眼症，當中76%為白領，且愈趨年輕化😖。\n\n造成乾眼症的原因廣泛，包括：\u003Cbr\u003E\n💡個人健康狀況（例如罹患乾燥症，女性過了更年期），淚水分泌減少\u003Cbr\u003E\n💡環境污染\u003Cbr\u003E\n💡長期配戴隱形眼鏡，或曾進行激光矯視手術\u003Cbr\u003E\n💡經常待在冷氣房間，空氣乾燥\u003Cbr\u003E\n💡長時間盯著電腦與手機，眨眼較少\u003Cbr\u003E\n💡長期服用降血壓藥、抗抑鬱藥等藥物\n\n眼乾人士為求方便，或會到藥房購買眼藥水使用，惟部份收紅筋的眼藥水的成分屬血管收縮劑，長期使用，眼睛只會越用越乾😰；另含防腐劑的人工淚水也容易引致敏感，必須慎用。\n\n要滋潤眼睛，舒緩或預防眼乾，可多補充胡蘿蔔素🥕。β胡蘿蔔素可以在體內轉化成維他命A，而維他命A號稱「眼睛的維他命」，是構成眼睛感光物質的重要原料。人體的維他命A充足，能有效預防夜盲症、乾眼症、角膜軟化症，並預防甚至改善視網膜黃斑部病變等眼部疾病，保持眼角膜的潤滑及透明度，建構眼睛的「保護膜」💪🏻。\n\n此外，視網膜感光細胞膜的成分50%以上是DHA，在眼睛中扮演極重要的抗氧化及保護作用。DHA在黃斑部具抗發炎及抗氧化作用，可抵抗光線對黃斑部的傷害，減少黃斑部病變；同時抑制眼睛表面發炎物產生，舒緩眼乾而導致的發炎不適症狀，並增加淚膜穩定度及基礎淚液量😉。DHA與維他命A亦具協同作用，能幫助身體吸收維他命A，相輔相成，事半功倍，故此飲食上應多攝取Omega-3奧米加三脂肪酸。","post200626","2020-06-26T00:00:00.000Z",{"data":4},{"data":10},[11],{"id":12,"attributes":13},1,{"slug":14,"name":15,"description":4,"createdAt":16,"updatedAt":16},"nutrition","營養隨筆","2023-02-12T02:39:02.691Z",{"data":18},[19,24,29,34,39,44,49],{"id":20,"attributes":21},140,{"name":22,"createdAt":23,"updatedAt":23},"眼睛","2023-02-12T03:32:01.349Z",{"id":25,"attributes":26},176,{"name":27,"createdAt":28,"updatedAt":28},"乾眼症","2023-02-12T03:32:01.370Z",{"id":30,"attributes":31},207,{"name":32,"createdAt":33,"updatedAt":33},"DHA","2023-02-12T03:32:01.389Z",{"id":35,"attributes":36},188,{"name":37,"createdAt":38,"updatedAt":38},"黃斑","2023-02-12T03:32:01.375Z",{"id":40,"attributes":41},182,{"name":42,"createdAt":43,"updatedAt":43},"維他命A","2023-02-12T03:32:01.372Z",{"id":45,"attributes":46},184,{"name":47,"createdAt":48,"updatedAt":48},"胡蘿蔔素","2023-02-12T03:32:01.373Z",{"id":50,"attributes":51},169,{"name":52,"createdAt":53,"updatedAt":53},"奧米加三","2023-02-12T03:32:01.366Z",{"data":4},{"data":56},[]],"uses":{"dependencies":["http://127.0.0.1:1337/api/posts?populate[author]=true&populate[categories]=true&populate[tags]=true&populate[image]=true&populate[related_posts]=true&filters[slug][$eq]=post200626"],"params":["slug"]}}]}