{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"data":1,"meta":48},[2,22,34],{"id":3,"attributes":4},7,{"start_date":5,"title":6,"content":7,"excerpt":8,"slug":9,"end_date":10,"tags":11,"createdAt":12,"updatedAt":12,"event_categories":13,"image":21},"2017-02-11","活化歷史, 文化傳承- 饒宗頤文化館","\n\n饒宗頤文化館前身為荔枝角醫院，為香港三級歷史建築。為服務當時社會的需求，之前曾為“豬仔館”、監獄、隔離站，歷盡社會變遷。\u003Cbr\u003E\n作為活化歷史建築項目，設計優雅的饒館繼續延續其社會任務，透過保育館、舊更亭和古石牆等歷史景點，展現饒館的今昔及保育過程。作為以國學大師饒宗頤命名的文化館，藝術館展出饒教授的藝術作品，並透過多媒體介紹饒教授的生平事蹟。\n\nEmpower 特別揀選元宵佳節，參觀這座有“城市綠洲”之稱的文化建築，與大家一起參與本地歷史文化的傳承，豐富我們的文化生活。\u003Cbr\u003E\n\n日期：2017年2月11日 (星期六)\u003Cbr\u003E\n時間：上午10:00-11:30\u003Cbr\u003E\n地點：九龍青山道800號饒宗頤文化館\u003Cbr\u003E\n費用：免費","","cultural1702",null,"饒宗頤文化館","2017-02-11T00:00:00.000Z",{"data":14},[15],{"id":16,"attributes":17},3,{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"data":10},{"id":23,"attributes":24},8,{"start_date":5,"title":25,"content":26,"excerpt":8,"slug":27,"end_date":10,"tags":28,"createdAt":12,"updatedAt":12,"event_categories":29,"image":33},"春日品茶趣·輕茶道","\n\n一片春日的落英，搭配微微的茶香，好不愜意。\u003Cbr\u003E\nEmpower 榮幸邀得瑜茶舍創辦人 Catherine，為我們開辦“春日品茶趣·輕茶道”工作坊，內容包括：\u003Cbr\u003E\n- 茶藝表演\u003Cbr\u003E\n- 茶文化及茶藝講解\u003Cbr\u003E\n- 何謂六大茶類\u003Cbr\u003E\n- 茶器運用\u003Cbr\u003E\n- 茶與禮儀\u003Cbr\u003E\n- 品茗一至兩種茶品\u003Cbr\u003E\n- 問答環節\u003Cbr\u003E\n⭐ 導師：Ms Catherine Yung，自幼跟隨經營普洱茶葉生意的媽媽穿梭中港兩地，拜訪不同茶道老師，登雲南茶山採茶葉。為令茶道年青化和時尚化，4年前創辦瑜茶舍，以平易近人的品茗體驗，讓更多年輕人能透過實地教學，領略傳統茶道之美","tea1702","茶道,荼藝",{"data":30},[31],{"id":16,"attributes":32},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":35,"attributes":36},5,{"start_date":37,"title":38,"content":39,"excerpt":8,"slug":40,"end_date":10,"tags":41,"createdAt":42,"updatedAt":42,"event_categories":43,"image":47},"2017-01-14","蛻變・美荷樓","\n\n2017年，Empower將安排各類歷史文化與藝術導賞團。1月我們將率先參觀被評為二級歷史建築的美荷樓。\u003Cbr\u003E\n美荷樓建於1954年，為現時碩果僅存的H型徒置大廈，亦是香港最早期公屋。活化後的美荷樓今日用作青年旅舍，並設有名為「美荷樓生活館」的展覽館，展示1950至70年代居民的生活寫照，以及他們艱苦奮進、自強不息的感人故事。\nEmpower榮幸邀得親身參與美荷樓活化工程的香港青年旅舍協會前主席黃奕鑑先生(Michael)為我們作星級導賞。Michael為新鴻基集團前執行董事，現為香港公開大學校董會主席。Michael 將引領我們走進美荷樓從徒置大廈蛻變為現代青年旅舍的超時空旅程，介紹老一輩香港人的生活起居，分享大導演吳宇森、資深大律師陳志海等名人的童年往事，體現無懼艱辛、肯捱肯搏的香港精神。\u003Cbr\u003E","cultural170114","美荷樓","2017-01-14T00:00:00.000Z",{"data":44},[45],{"id":16,"attributes":46},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"pagination":49},{"page":16,"pageSize":50,"pageCount":16,"total":51},12,27],"uses":{"dependencies":["http://127.0.0.1:1337/api/events?sort=start_date%3Adesc&populate[author]=true&populate[event_categories]=true&populate[image]=true&pagination[page]=3&pagination[pageSize]=12&filters[event_categories][slug]=cultural"],"params":["page","category"]}}]}