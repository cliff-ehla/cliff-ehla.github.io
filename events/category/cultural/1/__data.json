:10,"updatedAt":10,"event_categories":11,"image":25},"2026-01-10","古蹟文化遊 - 屏山文物徑","\u003Cp\u003E古蹟文化遊 - 屏山文物徑\u003C\u002Fp\u003E\u003Cp\u003E今次我們漫遊元朗古村落，走訪香港首條文物徑 — 屏山文物徑，細味中國傳統建築。\u003Cbr\u003E漫步後，一同享用廣東傳統美食「九大簋」，感受傳統節日美食文化！\u003C\u002Fp\u003E\u003Cp\u003E今次郊遊路線：屏山天水圍圖書館(有全港最美圖書館之美譽)→屏山鄧族(三圍六村)\u002F文物徑：聚星樓→達德公所→上璋圍→坑頭村→鄧氏宗祠→屏山鄧族文物館→九大簋午餐（預計時間為2小時）\u003Cbr\u003E🌟 歷史學家蘇銳鴻校長專業導賞\u003C\u002Fp\u003E\u003Cp\u003E日期：10\u002F1\u002F2026 星期六\u003Cbr\u003E時間：9:30-14:00&nbsp;\u003Cbr\u003E（若不午餐，12:00解散）\u003Cbr\u003E集合地點：9:30港鐵屯馬綫天水圍站D出口出閘後\u003Cbr\u003E午餐費用：$238，必須預先繳費留座\u003Cbr\u003E備註：路面平坦易行\u003C\u002Fp\u003E\u003Cp\u003EPowered by Empower&nbsp;\u003Cbr\u003Ewww.empower.hk\u003Cbr\u003EFacebook.com\u002Fempower.hk\u003C\u002Fp\u003E",null,"Ping-Shan-Heritage-Trail-260110","2025-12-23T03:41:48.906Z",{"data":12},[13,19],{"id":14,"attributes":15},3,{"name":16,"slug":17,"description":8,"createdAt":18,"updatedAt":18},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":20,"attributes":21},4,{"name":22,"slug":23,"description":8,"createdAt":24,"updatedAt":24},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"data":26},{"id":27,"attributes":28},84,{"name":29,"alternativeText":8,"caption":8,"width":30,"height":31,"formats":32,"hash":63,"ext":34,"mime":37,"size":64,"url":65,"previewUrl":8,"provider":66,"provider_metadata":8,"createdAt":67,"updatedAt":67},"1a.jpeg",1600,1146,{"large":33,"small":42,"medium":49,"thumbnail":56},{"ext":34,"url":35,"hash":36,"mime":37,"name":38,"path":8,"size":39,"width":40,"height":41},".jpeg","https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_1a_5da3c1581a.jpeg","large_1a_5da3c1581a","image\u002Fjpeg","large_1a.jpeg",125.87,1000,716,{"ext":34,"url":43,"hash":44,"mime":37,"name":45,"path":8,"size":46,"width":47,"height":48},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_1a_5da3c1581a.jpeg","small_1a_5da3c1581a","small_1a.jpeg",43.6,500,358,{"ext":34,"url":50,"hash":51,"mime":37,"name":52,"path":8,"size":53,"width"