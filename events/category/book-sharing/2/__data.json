{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"data":1,"meta":243},[2,63,108,122,136,150,164,178,192,205,217,231],{"id":3,"attributes":4},166,{"start_date":5,"title":6,"content":7,"excerpt":8,"slug":9,"end_date":10,"tags":8,"createdAt":11,"updatedAt":12,"event_categories":13,"image":21},"2022-06-20","＜營養讀書會＞星級版","\u003Cp\u003E＜營養讀書會＞自5月開辦以來，每星期都吸引希望活學營養知識，過上更健康快活人生的朋友一起參加🤗。\u003C\u002Fp\u003E\u003Cp\u003E&nbsp;6月20日的營養讀書會，Empower榮幸邀得📘《營養謬誤》的作者、在醫學界赫赫有名的袁維康醫生親臨分享！ 袁醫生為牙醫醫學士、自然醫學博士及中醫醫學博士，為少數擁有3個不同領域的醫學學位的醫生，醫見獨到精闢。 當晚袁醫生將介紹著書背景，並深入淺出地剖析「脂肪謬誤」，令大家更能營營求真，濡養思維，明辨謬見，告別迷誤。&nbsp;\u003C\u002Fp\u003E\u003Cp\u003E日期：6月20日（星期一）\u003Cbr\u003E時間：晚上7:30-9:15&nbsp;\u003Cbr\u003E地點：尖沙咀漢口道騏生商業中心14樓1402室 活然自然醫學診療中心（袁醫生醫務所）&nbsp;\u003Cbr\u003E費用：全免 歡迎邀請關注健康的親友一起參加。營養生活化，生活營養化，打造健康生活圈！💪🏻 Powered by Empower&nbsp;\u003Cbr\u003Ewww.Empower.hk&nbsp;\u003Cbr\u003EFacebook.com\u002FEmpower.hk&nbsp;\u003Cbr\u003EYouTube.com\u002FEmpowerhk\u003C\u002Fp\u003E","","nutrition-book-sharing-220620",null,"2023-02-12T03:35:51.745Z","2023-08-06T07:23:36.988Z",{"data":14},[15],{"id":16,"attributes":17},1,{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"data":22},{"id":23,"attributes":24},24,{"name":25,"alternativeText":10,"caption":10,"width":26,"height":27,"formats":28,"hash":58,"ext":30,"mime":33,"size":59,"url":60,"previewUrl":10,"provider":61,"provider_metadata":10,"createdAt":62,"updatedAt":62},"286280056_5405866762766883_3953441335604489026_n.jpg",1600,1200,{"large":29,"small":38,"medium":45,"thumbnail":51},{"ext":30,"url":31,"hash":32,"mime":33,"name":34,"path":10,"size":35,"width":36,"height":37},".jpg","https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_286280056_5405866762766883_3953441335604489026_n_3431c1e731.jpg","large_286280056_5405866762766883_3953441335604489026_n_3431c1e731","image\u002Fjpeg","large_286280056_5405866762766883_3953441335604489026_n.jpg",148.65,1000,750,{"ext":30,"url":39,"hash":40,"mime":33,"name":41,"path":10,"size":42,"width":43,"height":44},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_286280056_5405866762766883_3953441335604489026_n_3431c1e731.jpg","small_286280056_5405866762766883_3953441335604489026_n_3431c1e731","small_286280056_5405866762766883_3953441335604489026_n.jpg",49.32,500,375,{"ext":30,"url":46,"hash":47,"mime":33,"name":48,"path":10,"size":49,"width":37,"height":50},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fmedium_286280056_5405866762766883_3953441335604489026_n_3431c1e731.jpg","medium_286280056_5405866762766883_3953441335604489026_n_3431c1e731","medium_286280056_5405866762766883_3953441335604489026_n.jpg",94.94,563,{"ext":30,"url":52,"hash":53,"mime":33,"name":54,"path":10,"size":55,"width":56,"height":57},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fthumbnail_286280056_5405866762766883_3953441335604489026_n_3431c1e731.jpg","thumbnail_286280056_5405866762766883_3953441335604489026_n_3431c1e731","thumbnail_286280056_5405866762766883_3953441335604489026_n.jpg",10.94,208,156,"286280056_5405866762766883_3953441335604489026_n_3431c1e731",271.79,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002F286280056_5405866762766883_3953441335604489026_n_3431c1e731.jpg","aws-s3","2023-08-06T07:23:32.212Z",{"id":64,"attributes":65},158,{"start_date":66,"title":67,"content":68,"excerpt":8,"slug":69,"end_date":10,"tags":70,"createdAt":71,"updatedAt":72,"event_categories":73,"image":77},"2022-05-02","Empower營養讀書會《營養謬誤》","\u003Cp\u003E📘Empower營養讀書會\u003Cbr\u003E營營求真，濡養思維\u003Cbr\u003E明辨謬見，告別迷誤 《營養謬誤》由在醫學界赫赫有名的袁維康醫生所著。袁醫生為牙醫醫學士、自然醫學博士及中醫醫學博士，為少數擁有3個不同領域的醫學學位的醫生，醫見獨到精闢。\u003Cbr\u003E我們榮幸邀得袁醫生的愛徒、自然療法醫生方婉君與我們一起研讀《營養謬誤》🥳。&nbsp;\u003C\u002Fp\u003E\u003Cp\u003E日期：5月2日起逢星期一\u003Cbr\u003E時間：晚上8:30-9:30\u003Cbr\u003E地點：旺角潮流特區16樓1605室Empower中心\u003Cbr\u003E📽️Zoom線上同步直播\u003Cbr\u003E費用：全免 透過每星期1️⃣小時的交流與分享，將書上知識活學活用，糾正眾多營養誤區，包括：\u003Cbr\u003E🤨高膽固醇會阻塞血管而引致心臟病？\u003Cbr\u003E🤨高鈣食物可預防骨質疏鬆？\u003Cbr\u003E🤨吃鹹的就會血壓高？ 歡迎大家邀請有意活學營養知識，過上更健康快活人生的親友一起參加🤗。\u003Cbr\u003E營養生活化，生活營養化，打造健康生活圈！💪🏻\u003C\u002Fp\u003E","nutrition-book-reading-2022-may","讀書會,讀書交流會","2022-04-05T00:00:00.000Z","2023-08-06T07:22:22.158Z",{"data":74},[75],{"id":16,"attributes":76},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":78},{"id":79,"attributes":80},23,{"name":81,"alternativeText":10,"caption":10,"width":82,"height":82,"formats":83,"hash":104,"ext":30,"mime":33,"size":105,"url":106,"previewUrl":10,"provider":61,"provider_metadata":10,"createdAt":107,"updatedAt":107},"cover.jpg",2400,{"large":84,"small":89,"medium":94,"thumbnail":99},{"ext":30,"url":85,"hash":86,"mime":33,"name":87,"path":10,"size":88,"width":36,"height":36},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_cover_70c8aa9392.jpg","large_cover_70c8aa9392","large_cover.jpg",127.18,{"ext":30,"url":90,"hash":91,"mime":33,"name":92,"path":10,"size":93,"width":43,"height":43},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_cover_70c8aa9392.jpg","small_cover_70c8aa9392","small_cover.jpg",42.5,{"ext":30,"url":95,"hash":96,"mime":33,"name":97,"path":10,"size":98,"width":37,"height":37},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fmedium_cover_70c8aa9392.jpg","medium_cover_70c8aa9392","medium_cover.jpg",78.28,{"ext":30,"url":100,"hash":101,"mime":33,"name":102,"path":10,"size":103,"width":57,"height":57},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fthumbnail_cover_70c8aa9392.jpg","thumbnail_cover_70c8aa9392","thumbnail_cover.jpg",6.5,"cover_70c8aa9392",517.34,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fcover_70c8aa9392.jpg","2023-08-06T07:22:14.550Z",{"id":109,"attributes":110},116,{"start_date":111,"title":112,"content":113,"excerpt":8,"slug":114,"end_date":10,"tags":115,"createdAt":116,"updatedAt":116,"event_categories":117,"image":121},"2020-04-04","讀書會2.0-心靈勵志","\n\n雞蛋從外打破是食物，從內打破是生命；人生從外打破是壓力，從內打破是成長。\u003Cbr\u003E\n生活壓力四方八面，幸好遇壓時總有書籍能助我們向前邁進。\u003Cbr\u003E\n今次讀書會，我們特別選擇分享心靈及勵志類書籍，讓大家共同成長，同時拓展我們生命的寬度及深度。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家一起閱讀，一起分享，相互啟發！\u003Cbr\u003E\n說書人：4位 (每位8分鐘)\u003Cbr\u003E\n日期：4\u002F4\u002F2020 (星期六)\u003Cbr\u003E\n時間：14:30-16:00\u003Cbr\u003E\n交流形式：將以Zoom Cloud Meetings軟件進行現場直播\u003Cbr\u003E\n費用：全免\u003Cbr\u003E\n備註：請先下載免費應用程式Zoom，連結將於稍後發放\n","booksharing2004","心靈勵志","2020-04-04T00:00:00.000Z",{"data":118},[119],{"id":16,"attributes":120},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":123,"attributes":124},108,{"start_date":125,"title":126,"content":127,"excerpt":8,"slug":128,"end_date":10,"tags":129,"createdAt":130,"updatedAt":130,"event_categories":131,"image":135},"2019-09-22","讀書會主題: 心靈·勵志","\n\n雞蛋從外打破是食物，從內打破是生命；人生從外打破是壓力，從內打破是成長。\u003Cbr\u003E\n生活壓力四方八面，幸好遇壓時總有書籍能助我們向前邁進。\u003Cbr\u003E\n今次讀書會，我們特別選擇分享心靈及勵志類書籍，讓大家共同成長，同時拓展我們生命的寬度及深度。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家一起閱讀，一起分享，相互啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：12位\u003Cbr\u003E\n日期：22\u002F9\u002F2019 (星期日)\u003Cbr\u003E\n時間：11:00-13:15\u003Cbr\u003E\n地點：據點・句點＠石硤尾賽馬會創意藝術中心三樓L306D\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","bookshare1909","心靈,勵志","2019-09-22T00:00:00.000Z",{"data":132},[133],{"id":16,"attributes":134},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":137,"attributes":138},99,{"start_date":139,"title":140,"content":141,"excerpt":8,"slug":142,"end_date":10,"tags":143,"createdAt":144,"updatedAt":144,"event_categories":145,"image":149},"2019-07-21","讀書會 - 主題：經濟·商業","\n\n經濟及商業模式在過去十多年經歷翻天覆地的變化。要探討當中的經濟發展規律及經濟現象成因，離不開剖析社會、政治與民族文化。\u003Cbr\u003E\n是次讀書會以\"經濟·商業\"出發，不僅希望藉閱讀與分享，讓我們加強掌握經邦濟世之道，更希望多方面探索世界，對大環境趨勢加深理解。\u003Cbr\u003E\n誠邀各位一起閱讀，交流討論，集思廣益，共同學習，共同進步！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：12位\u003Cbr\u003E\n日期：21\u002F7\u002F2019 (星期日)\u003Cbr\u003E\n時間：11:00-13:15\u003Cbr\u003E\n地點：據點・句點＠石硤尾賽馬會創意藝術中心三樓L306D\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","bookshare1907","經濟,商業","2019-07-21T00:00:00.000Z",{"data":146},[147],{"id":16,"attributes":148},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":151,"attributes":152},86,{"start_date":153,"title":154,"content":155,"excerpt":8,"slug":156,"end_date":10,"tags":157,"createdAt":158,"updatedAt":158,"event_categories":159,"image":163},"2019-05-19","讀書會-主題：人物傳記","\n\n「以銅爲鑒，可正衣冠；以古爲鑒，可知興替；以人爲鑒，可明得失。」\u003Cbr\u003E\n生命影響生命，今次讀書會，我們將分享傳記類書籍。透過別人獨到的經歷，以人為鑒，啟迪智慧與心靈。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家，一起閱讀、一起分享、互相啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：12位\u003Cbr\u003E\n備註：分享書籍的朋友，請於16\u002F5或之前通知我們書名及作者，最好有網址連結讓我們大約知道書本內容，讓分享會更順暢進行\u003Cbr\u003E\n日期：19\u002F5\u002F2019 (星期日)\u003Cbr\u003E\n時間：11:00-13:15\u003Cbr\u003E\n地點：據點・句點＠石硤尾賽馬會創意藝術中心三樓L306D\u003Cbr\u003E\n費用：$70一位，包一杯飲品及小食\u003Cbr\u003E\n名額：16人 （四位說書人）","bookshare1905","人物傳記","2019-05-19T00:00:00.000Z",{"data":160},[161],{"id":16,"attributes":162},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":165,"attributes":166},83,{"start_date":167,"title":168,"content":169,"excerpt":8,"slug":170,"end_date":10,"tags":171,"createdAt":172,"updatedAt":172,"event_categories":173,"image":177},"2019-03-10","讀書會：歷史與未來","\n\n歷史塑造了我們的科技、政治和社會，也塑造了我們的思想和夢想。現實彷彿是自然又理所當然。\u003Cbr\u003E\n今次的讀書會，讓我們一起分享讓人們從過去走到現在的事，以不同角度閱讀現在，思考不一樣的未來。\u003Cbr\u003E\n同場加映：《據點。句點》藝術空間舉辦的展覽 — 《無法取得位置 Nothing Can Come Closer》，詳情見 https:\u002F\u002Fwww.facebook.com\u002Fevents\u002F376729836439046\u002F?ti=icl\n\n愛書人：12位\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n分享書藉包括：\u003Cbr\u003E\n－\"Factfulness: Ten Reasons We're Wrong About The World - And Why Things Are Better Than You Think\"- Hans Rosling\u003Cbr\u003E\n－《從中國歷史來看中國民族性及中國文化》錢穆\u003Cbr\u003E\n－《讀史觀勢》張建雄\u003Cbr\u003E\n－《第二次世界大戰史》馬丁・吉爾伯特\u003Cbr\u003E\n日期：10\u002F3\u002F2019 (星期六)\u003Cbr\u003E\n時間：\u003Cbr\u003E\n12:00-14:00（讀書會）\u003Cbr\u003E\n14:00-15:00（展覽導賞）\u003Cbr\u003E\n地點：據點。句點 (石硤尾賽馬會創意藝術中心3樓L306D Floating Project)\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","bookshare1903","歷史","2019-03-10T00:00:00.000Z",{"data":174},[175],{"id":16,"attributes":176},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":179,"attributes":180},74,{"start_date":181,"title":182,"content":183,"excerpt":8,"slug":184,"end_date":10,"tags":185,"createdAt":186,"updatedAt":186,"event_categories":187,"image":191},"2019-01-13","讀書會主題：健康·養生","\n正所謂，年少不養生，老來養醫生。\u003Cbr\u003E\n壓大很大，糖衣很美。餐廳充斥著高油高脂的美食，高效的社會同時亦帶來高壓。我們並不能抱著「今朝有酒今朝醉，哪管他朝吊鹽水」的心態。\u003Cbr\u003E\n健康，既指肉體上的，亦指心靈上的健康。\u003Cbr\u003E\n達到身心靈的平衡不僅使我們身體健康，亦促使我們成就完滿的人生。\u003Cbr\u003E\n今次讀書會，我們特別選擇了分享健康養生類書籍，共同朝向身心靈整體健康的目標前進。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家一起閱讀，一起分享，相互啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n日期：6\u002F01\u002F2019 (星期日)\u003Cbr\u003E\n時間：14:00-16:00\u003Cbr\u003E\n地點：Coffee Lover (觀塘偉業街171號偉業工業大廈3\u002FF B室)\u003Cbr\u003E\n牛頭角MTR B出口，悅景海景酒店側\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","bookshare1901","健康","2019-01-13T00:00:00.000Z",{"data":188},[189],{"id":16,"attributes":190},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":193,"attributes":194},68,{"start_date":195,"title":140,"content":196,"excerpt":8,"slug":197,"end_date":10,"tags":198,"createdAt":199,"updatedAt":199,"event_categories":200,"image":204},"2018-11-03","\n\n經濟及商業模式在過去十多年經歷翻天覆地的變化。要探討當中的經濟發展規律及經濟現象成因，離不開剖析社會、政治與民族文化。\u003Cbr\u003E\n是次讀書會以\"經濟·商業\"出發，不僅希望藉閱讀與分享，讓我們加強掌握經邦濟世之道，更希望多方面探索世界，對大環境趨勢加深理解。\u003Cbr\u003E\n誠邀各位一起閱讀，交流討論，集思廣益，共同學習，共同進步！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：12位\u003Cbr\u003E\n日期：3\u002F11\u002F2018 (星期六)\u003Cbr\u003E\n時間：14:30-16:30\u003Cbr\u003E\n地點：Coffee Lover (觀塘偉業街171號偉業工業大廈3\u002FF B室)\u003Cbr\u003E\n牛頭角MTR B出口，悅景海景酒店側\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","bookshare1811","商業經濟","2018-11-03T00:00:00.000Z",{"data":201},[202],{"id":16,"attributes":203},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":206,"attributes":207},67,{"start_date":208,"title":154,"content":209,"excerpt":8,"slug":210,"end_date":10,"tags":157,"createdAt":211,"updatedAt":211,"event_categories":212,"image":216},"2018-09-08","\n\n「以銅爲鑒，可正衣冠；以古爲鑒，可知興替；以人爲鑒，可明得失。」\u003Cbr\u003E\n生命影響生命，今次讀書會，我們將分享傳記類書籍。透過別人獨到的經歷，以人為鑒，啟迪智慧與心靈。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家，一起閱讀、一起分享、互相啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n備註：分享書籍的朋友，請於1\u002F9或之前通知我們書名及作者，最好有網址連結讓我們大約知道書本內容，讓分享會更順暢進行\u003Cbr\u003E\n日期：8\u002F9\u002F2017 (星期六)\u003Cbr\u003E\n時間：14:15-16:30\u003Cbr\u003E\n地點：咖啡綠茶＠旺角西洋菜南街38-40號萬高商業大廈3樓\u003Cbr\u003E\n費用：自費在餐廳點餐\u002F飲品\u003Cbr\u003E\n名額：14人\u003Cbr\u003E\n備註：以網站報名為準，我們將會回覆閣下的報名登記","booksharing1809","2018-09-08T00:00:00.000Z",{"data":213},[214],{"id":16,"attributes":215},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":218,"attributes":219},52,{"start_date":220,"title":221,"content":222,"excerpt":8,"slug":223,"end_date":10,"tags":224,"createdAt":225,"updatedAt":225,"event_categories":226,"image":230},"2018-07-07","讀書會主題：歷史・遊記","\n\n從文字遊覽五大洲七大洋，觀看萬千世界；從歷史了解各民族興衰成敗，感受各地文化。\u003Cbr\u003E\n今次讀書會，我們特別選擇了分享歷史及遊記類書籍，讀萬卷書也行萬里路，了解不同地區歷史文化，感受各民族的風土人情。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家，一起閱讀、一起分享、共同啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n日期：7\u002F7\u002F2018 (星期六)\u003Cbr\u003E\n時間：14:15-16:30\u003Cbr\u003E\n地點：咖啡綠茶＠旺角西洋菜南街38-40號萬高商業大廈3樓\u003Cbr\u003E\n費用：自費在餐廳點單\u003Cbr\u003E\n名額：14人","bookshare1807","歷史,遊記","2018-07-07T00:00:00.000Z",{"data":227},[228],{"id":16,"attributes":229},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":232,"attributes":233},44,{"start_date":234,"title":126,"content":235,"excerpt":8,"slug":236,"end_date":10,"tags":115,"createdAt":237,"updatedAt":237,"event_categories":238,"image":242},"2018-05-19","\n雞蛋從外打破是食物，從內打破是生命；人生從外打破是壓力，從內打破是成長。\u003Cbr\u003E\n生活壓力四方八面，幸好遇壓時總有書籍能助我們向前邁進。\u003Cbr\u003E\n今次讀