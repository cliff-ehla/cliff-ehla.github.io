nail":487},{"ext":142,"url":471,"hash":472,"mime":145,"name":473,"path":5,"size":474,"width":46,"height":60},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325.png","large_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325","large_Screenshot 2023-08-01 at 2.42.18 PM.png",1150.14,{"ext":142,"url":476,"hash":477,"mime":145,"name":478,"path":5,"size":479,"width":53,"height":480},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325.png","small_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325","small_Screenshot 2023-08-01 at 2.42.18 PM.png",347.06,375,{"ext":142,"url":482,"hash":483,"mime":145,"name":484,"path":5,"size":485,"width":60,"height":486},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fmedium_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325.png","medium_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325","medium_Screenshot 2023-08-01 at 2.42.18 PM.png",688.75,563,{"ext":142,"url":488,"hash":489,"mime":145,"name":490,"path":5,"size":491,"width":212,"height":67},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fthumbnail_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325.png","thumbnail_Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325","thumbnail_Screenshot 2023-08-01 at 2.42.18 PM.png",77.21,"Screenshot_2023_08_01_at_2_42_18_PM_8b452a7325",1110.73,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002FScreenshot_2023_08_01_at_2_42_18_PM_8b452a7325.png","2023-08-06T07:36:51.551Z",{"id":497,"attributes":498},174,{"start_date":499,"title":500,"content":501,"excerpt":5,"slug":502,"end_date":5,"tags":5,"createdAt":503,"updatedAt":503,"event_categories":504,"image":508},"2023-04-24","營養讀書會《失傳的營養學 遠離疾病》","\u003Cp\u003E📘 Empower營養讀書會\u003Cbr\u003E《失傳的營養學 遠離疾病》\u003C\u002Fp\u003E\u003Cp\u003E冠心病、腦血栓、高血壓、糖尿病、痛風、脂肪肝、失眠、腦退化...... 醫學上認為終身難治的疾病，可以用簡單的方法治癒 — 這方法就是「吃飯」！😯\u003C\u002Fp\u003E\u003Cp\u003E許多人只知道吃飯是為了活著為了享受，卻不知道吃飯的真正意義是獲取營養。 只要有了足夠的營養，任何疾病身體都能自行修復，重拾健康💪🏻。\u003C\u002Fp\u003E\u003Cp\u003E《失傳的營養學 遠離疾病》的作者王濤為醫學博士，卻另闢蹊徑，將西醫、中醫、營養學融會貫通，開創一套全新的理論體系 「營養醫學」，真正體現「藥食同源」，幫助 有病患的治癒，沒病患的維護健康❤️！\u003C\u002Fp\u003E\u003Cp\u003E4月24日起逢星期一，就讓我們一起研讀細味這本「有生命的書」， 深入了解我們每天所吃所喝的營養，真正認識陪伴我們一生的大夫 — 奇妙的身體。\u003C\u002Fp\u003E\u003Cp\u003E日期：4月24日起逢星期一\u003Cbr\u003E時間：晚上8:30\u003Cbr\u003E地點：旺角彌敦道580A號周大福商業中心16樓1605-06室Empower中心，Zoom線上同步直播\u003Cbr\u003E費用：全免\u003C\u002Fp\u003E\u003Cp\u003EPowered by Empower\u003Cbr\u003EFacebook.com\u002FEmpower.hk\u003Cbr\u003EYouTube.com\u002FEmpowerhk\u003C\u002Fp\u003E","the-lost-knowledge-in-nutrition","2023-08-06T06:54:15.816Z",{"data":505},[506],{"id":19,"attributes":507},{"name":21,"slug":22,"description":5,"createdAt":23,"updatedAt":23},{"data":509},{"id":510,"attributes":511},13,{"name":512,"alternativeText":5,"caption":5,"width":513,"height":514,"formats":515,"hash":533,"ext":230,"mime":42,"size":534,"url":535,"previewUrl":5,"provider":71,"provider_metadata":5,"createdAt":536,"updatedAt":536},"344538957_615328940626356_1440202392454251816_n.jpg",960,715,{"small":516,"medium":522,"thumbnail":528},{"ext":230,"url":517,"hash":518,"mime":42,"name":519,"path":5,"size":520,"width":53,"height":521},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_344538957_615328940626356_1440202392454251816_n_f9fc7c9fc2.jpg","small_344538957_615328940626356_1440202392454251816_n_f9fc7c9fc2","small_344538957_615328940626356_1440202392454251816_n.jpg",49.67,372,{"ext":230,"url":523,"hash":524,"mime":42,"name":525,"path":5,"size":526,"width":60,"height":527},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fmedium_344538957_615328940626356_1440202392454251816_n_f9fc7c9fc2.jpg","medium_344538957_615328940626356_1440202392454251816_n_f9fc7c9fc2","medium_344538957_615328940626356_1440202392454251816_n.jpg",86.41,559,{"ext":230,"url":529,"hash":530,"mime":42,"name":531,"path":5,"size":532,"width":122,"height":67},"https:\u002F\u002Fempowerhk.s3