{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"data":1,"meta":193},[2,23,42,57,75,93,108,122,136,150,165,179],{"id":3,"attributes":4},59,{"title":5,"content":6,"start_date":7,"excerpt":8,"slug":9,"end_date":10,"tags":11,"createdAt":12,"updatedAt":12,"event_categories":13,"image":22},"中國近代史雜談：從一朵芙蓉花的前世今生說起","\n\n分享重點：\u003Cbr\u003E\n－「阿芙蓉」鴉片如何影響中國以至亞洲其他地區的社會、經濟及文化發展？\u003Cbr\u003E\n－「正斗」、「渣斗」、「吞pok」、「一蚊雞」的由來都與鴉片有關？\n\n分享嘉賓：蘇銳鴻校長\u003Cbr\u003E\n－退休校長、資深教育工作者、歷史學家\u003Cbr\u003E\n－歷任教育局教科書審查委員、中國文化研究院專題審查委員\u003Cbr\u003E\n－現為香港金融管理學院兼任講師、泛亞教育機構顧問、和富社會企業青少年網絡執行委員\u003Cbr\u003E\n－著有《紅船淺探》、《香港百聞》、《國史百聞》等書\n\n日期：2018年7月22日(日)\u003Cbr\u003E\n時間：晚上7：15 - 9：30\u003Cbr\u003E\n地點：旺角登打士街56號家樂坊15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90一位\u002F$230三位 (包三文治及飲品)","2018-07-22","蘇銳鴻校長","mr-so",null,"中國近代史","2018-07-22T00:00:00.000Z",{"data":14},[15],{"id":16,"attributes":17},2,{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"data":10},{"id":24,"attributes":25},52,{"title":26,"content":27,"start_date":28,"excerpt":29,"slug":30,"end_date":10,"tags":31,"createdAt":32,"updatedAt":32,"event_categories":33,"image":41},"讀書會主題：歷史・遊記","\n\n從文字遊覽五大洲七大洋，觀看萬千世界；從歷史了解各民族興衰成敗，感受各地文化。\u003Cbr\u003E\n今次讀書會，我們特別選擇了分享歷史及遊記類書籍，讀萬卷書也行萬里路，了解不同地區歷史文化，感受各民族的風土人情。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家，一起閱讀、一起分享、共同啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n日期：7\u002F7\u002F2018 (星期六)\u003Cbr\u003E\n時間：14:15-16:30\u003Cbr\u003E\n地點：咖啡綠茶＠旺角西洋菜南街38-40號萬高商業大廈3樓\u003Cbr\u003E\n費用：自費在餐廳點單\u003Cbr\u003E\n名額：14人","2018-07-07","","bookshare1807","歷史,遊記","2018-07-07T00:00:00.000Z",{"data":34},[35],{"id":36,"attributes":37},1,{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"data":10},{"id":43,"attributes":44},58,{"title":45,"content":46,"start_date":47,"excerpt":48,"slug":49,"end_date":10,"tags":50,"createdAt":51,"updatedAt":51,"event_categories":52,"image":56},"生・老・病・死","\n\n－曾任『無國界醫生』香港區主席8年\u003Cbr\u003E\n－NGO『毋忘愛』及『醫護行者』創辦人兼主席\u003Cbr\u003E\n－第二屆香港人道年女奬得主\u003Cbr\u003E\n－樹藝技術員\n\n分享重點：\n－老化不是市場，不是災難⋯⋯只是一個力場\u003Cbr\u003E\n－死點測？\n\n日期：2018年6月16日(六)\u003Cbr\u003E\n時間：晚上7：15 - 9：30\u003Cbr\u003E\n地點：旺角登打士街56號柏裕商業中心15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90一位\u002F$230三位 (包三文治及飲品)\u003Cbr\u003E\n截止報名日期： 2018年6月11日","2018-06-16","曾任『無國界醫生』香港區主席、ngo『毋忘愛』及『醫護行者』創辦人兼主席范寧醫生","dr-fan","老化","2018-06-16T00:00:00.000Z",{"data":53},[54],{"id":16,"attributes":55},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":58,"attributes":59},49,{"title":60,"content":61,"start_date":62,"excerpt":29,"slug":63,"end_date":10,"tags":64,"createdAt":65,"updatedAt":65,"event_categories":66,"image":74},"1 小時玩轉程式","\n\n－推動香港普及編程教育至所有年齡、性別，以及各行各業人士\u003Cbr\u003E\n－把在香港想學習編程和想教授編程的人連繫一起\n\n主理：香港城市大學電子工程學系副教授兼『香港一小時編程』創辦人張澤松博士\u003Cbr\u003E\n日期：2018年6月9日（六）\u003Cbr\u003E\n時間：早上10:30-12:00\u003Cbr\u003E\n地點：香港城市大學 Apps Lab\u003Cbr\u003E\n費用：HoC免費，之後與Dr Ray一起自費在城大午膳\u003Cbr\u003E\n備註：請自備電腦","2018-06-09","coding1806","編程","2018-06-09T00:00:00.000Z",{"data":67},[68],{"id":69,"attributes":70},3,{"name":71,"slug":72,"description":10,"createdAt":73,"updatedAt":73},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"data":10},{"id":76,"attributes":77},56,{"title":78,"content":79,"start_date":80,"excerpt":29,"slug":81,"end_date":10,"tags":82,"createdAt":83,"updatedAt":83,"event_categories":84,"image":92},"週末郊遊鬆一鬆：城門水塘觀賞白千層","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地環繞城門水塘一圈，觀賞塘畔的白千層。漫步水塘、欣賞醉人景緻、細聽猴子猴孫吱吱私語。\u003Cbr\u003E\n行完山，一齊飲埋茶，食埋晏先走！\u003Cbr\u003E\n預計行山時間為3小時\u003Cbr\u003E\n備註：切勿帶膠袋\u002F背心袋\u002F單揹環保袋，沿途不建議邊行邊食小食。\u003Cbr\u003E\n日期：2\u002F6\u002F2018 星期六\u003Cbr\u003E\n時間：9:15-14:30（若不午餐，預計13:30到荃灣）\u003Cbr\u003E\n集合地點：\u003Cbr\u003E\n選項1: 10:00於城門水塘小巴總站\u003Cbr\u003E\n選項2: 09:15於荃灣地鐵站綠楊坊出口等\u003Cbr\u003E\n*若不標明，就當大家是在選項二集合","2018-06-02","hiking1806","城門水塘","2018-06-02T00:00:00.000Z",{"data":85},[86],{"id":87,"attributes":88},4,{"name":89,"slug":90,"description":10,"createdAt":91,"updatedAt":91},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"data":10},{"id":94,"attributes":95},54,{"title":96,"content":97,"start_date":98,"excerpt":99,"slug":100,"end_date":10,"tags":101,"createdAt":102,"updatedAt":102,"event_categories":103,"image":107},"人人跑步·人人跑數","\n\n分享嘉寳：陳兆焯博士(基督教正生書院校長兼正生會營運總監、香港十大傑出青年)\u003Cbr\u003E\n－ 陳校長春風化雨逾30載，服務社會的邊緣青年20多年。創立本港第一所亦是唯一一所以濫藥青少年為對象的中學「正生書院」，課程兼重學術與職業訓練，讓學生在課餘時間創立各種自負盈虧的生意\u003Cbr\u003E\n－ 15年內走訪逾350所中學及250間機構，向超過13 萬人宣傳濫用藥物的禍害；並透過大眾傳播媒介及其著作，分享其經歷及信念\u003Cbr\u003E\n－ 近年與學生遠赴撒哈拉、雅典、三藩市等地跑馬拉松，藉此鼓勵學生挑戰自已，攜手追夢\n\n分享重點：\u003Cbr\u003E\n陳校長將分享其跑步及跑數經歷，如何戰勝常變世事，戰勝不可能！\n\n日期：2018年5月11日(五)\u003Cbr\u003E\n時間：晚上7：15-9：30\u003Cbr\u003E\n地點：旺角登打士街56號柏裕商業中心15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90一位\u002F$230三位 (包三文治及飲品)","2018-05-25","基督教正生書院校長兼正生會營運總監陳兆焯博士","alman-chan","跑步","2018-05-25T00:00:00.000Z",{"data":104},[105],{"id":16,"attributes":106},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":109,"attributes":110},45,{"title":111,"content":112,"start_date":113,"excerpt":29,"slug":114,"end_date":10,"tags":115,"createdAt":116,"updatedAt":116,"event_categories":117,"image":121},"行山團 - 砲台探秘","\n\n每天工作於侷促的辦公室，行走在煩囂的市區，放假當然要逃出市區抖抖氣！\u003Cbr\u003E\n今次我地由油塘高超道出發，經過魔鬼山砲台，沿途風光明媚，可遠眺港島的柏架山及西灣河一帶，東觀釣魚翁，南瞰鯉魚門及柴灣，西望九龍東、港島北，俯瞰將軍澳，一嘗大地在我腳下的滋味。\u003Cbr\u003E\n行完山，一齊行到將軍澳新都城，食埋晏歎埋茶先走！\u003Cbr\u003E\n今次登山路線：油塘高超道-\u003E魔鬼山-\u003E五桂山-\u003E茅湖山-\u003E靈實醫院\u003Cbr\u003E\n（預計行山時間為3小時）\u003Cbr\u003E\n日期：22\u002F5\u002F2018 星期二（公眾假期）\u003Cbr\u003E\n時間：9:30-14:30 （預計13:00到新都城）\u003Cbr\u003E\n集合地點：油塘港鐵站A2出口（9：30，不見即散）","2018-05-22","hiking1805","魔鬼山,五桂山,茅湖山","2018-05-22T00:00:00.000Z",{"data":118},[119],{"id":87,"attributes":120},{"name":89,"slug":90,"description":10,"createdAt":91,"updatedAt":91},{"data":10},{"id":123,"attributes":124},44,{"title":125,"content":126,"start_date":127,"excerpt":29,"slug":128,"end_date":10,"tags":129,"createdAt":130,"updatedAt":130,"event_categories":131,"image":135},"讀書會主題: 心靈·勵志","\n雞蛋從外打破是食物，從內打破是生命；人生從外打破是壓力，從內打破是成長。\u003Cbr\u003E\n生活壓力四方八面，幸好遇壓時總有書籍能助我們向前邁進。\u003Cbr\u003E\n今次讀書會，我們特別選擇分享心靈及勵志類書籍，讓大家共同成長，同時拓展我們生命的寬度及深度。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家一起閱讀，一起分享，相互啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n日期：19\u002F5\u002F2017 (星期六)\u003Cbr\u003E\n時間：14:15-16:30\u003Cbr\u003E\n地點：咖啡綠茶＠旺角西洋菜南街38-40號萬高商業大廈3樓\u003Cbr\u003E\n費用：自費在餐廳點單\u003Cbr\u003E\n名額：14人","2018-05-19","booksharing1805","心靈勵志","2018-05-19T00:00:00.000Z",{"data":132},[133],{"id":36,"attributes":134},{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},{"data":10},{"id":137,"attributes":138},43,{"title":139,"content":140,"start_date":141,"excerpt":29,"slug":142,"end_date":10,"tags":143,"createdAt":144,"updatedAt":144,"event_categories":145,"image":149},"周末郊遊鬆一鬆：都市綠洲- 藍地水塘","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地探訪環境清幽的屯門藍地水塘。\u003Cbr\u003E\n藍地水塘建於1957年，為灌溉水塘之一，水塘雖小，但環境清幽風景如畫。\u003Cbr\u003E\n由屯門市出發，沿途風光明媚，途中可以俯瞰屯門市景色，並經過富有特色的七色彩虹欄杆。\u003Cbr\u003E\n行完山，一齊在嶺大校園內酒樓食埋晏先走！\u003Cbr\u003E\n同場加映：嶺南大學導賞（有意參加的朋友可以午餐後留下，導賞約30分鐘）\u003Cbr\u003E\n今次登山路線：屯門何福堂 》 麥徑十段 》 屯門徑二段 》 沿藍地水塘到大水壩 》 虎地下村\u003Cbr\u003E\n（預計行山時間為3小時）\u003Cbr\u003E\n備註：大部分為石屎路，當中有樓梯上落。\u003Cbr\u003E\n日期：21\u002F4\u002F2018 星期六\u003Cbr\u003E\n時間：9:30-14:30（若不午餐，預計12:30到嶺南大學）\u003Cbr\u003E\n集合地點：屯門西鐵站 A出口杯渡路（9:30，不見即散）","2018-04-21","hiking1804","藍地水塘","2018-04-21T00:00:00.000Z",{"data":146},[147],{"id":87,"attributes":148},{"name":89,"slug":90,"description":10,"createdAt":91,"updatedAt":91},{"data":10},{"id":151,"attributes":152},51,{"title":153,"content":154,"start_date":155,"excerpt":156,"slug":157,"end_date":10,"tags":158,"createdAt":159,"updatedAt":159,"event_categories":160,"image":164},"蘇東坡的多采人生對現代優質生活的啟示","\n\n- 曾任珠海書院中國文史系主任及中國文史研究所副所長、香港中文大學教育學院兼任講師\u003Cbr\u003E\n- 香港電台清談節目《清晨爽利》及《講東講西》嘉賓主持\n\n分享重點：\n- 在現實人生中，怎樣的生活才是優質生活？\u003Cbr\u003E\n﻿- 怎樣從蘇東坡的多采人生中，學到創造優質生活的本領？\u003Cbr\u003E\n岑教授在報章雜誌發表文章多篇，討論中國歷史文化、管理和人格教育問題。因見解揉合東西及古今文化精華，深受學術界與教育界重視，94年獲中華臺北僑委會海外華文著述學術論著社會人文及科學優等獎\n\n日期：2018年4月8日(日)\u003Cbr\u003E\n時間：晚上7：15 - 9：30\u003Cbr\u003E\n地點：旺角登打士街56號柏裕商業中心15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90一位\u002F$230三位 (包三文治及飲品)","2018-04-08","香港電台清談節目《清晨爽利》及《講東講西》嘉賓主持岑練英教授","professor-sum","蘇東坡","2018-04-08T00:00:00.000Z",{"data":161},[162],{"id":16,"attributes":163},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":166,"attributes":167},48,{"title":168,"content":169,"start_date":170,"excerpt":29,"slug":171,"end_date":10,"tags":172,"createdAt":173,"updatedAt":173,"event_categories":174,"image":178},"讀書會主題：動漫狂派","\n\n漫畫，一直被視為次文化，然而其影響力與日俱增，更衍生出動畫、電玩、模型等不同類型的創作，風靡全世界，是另類的藝術平台。\u003Cbr\u003E\n由生活小品，以至歷史記載，諷刺時弊，內容主題十分多樣。而漫畫又以東洋及歐美作分水嶺，各自運用着不用的繪畫技巧，描繪出一幅又一幅藝術作品。\u003Cbr\u003E\n透過這次讀書會，希望藉此打破大家對漫畫的成見與迷思，以開放的態度，去了解及踏足這深邃又引人入勝的動漫世界。\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n備註：分享書籍的朋友，請於17\u002F3或之前通知我們書名及作者，最好有網址連結讓我們大約知道書本內容，讓分享會更順暢進行。\u003Cbr\u003E\n日期：24\u002F03\u002F2018 (星期六)\u003Cbr\u003E\n時間：14:15-16:30\u003Cbr\u003E\n地點：咖啡綠茶＠旺角西洋菜南街38-40號萬高商業大廈3樓\u003Cbr\u003E\n費用：自費在餐廳點單\u003Cbr\u003E\n名額：14人","2018-03-24","bookshare1803","動漫","2018-03-24T00:00:00.000Z",{"data":175},[176],{"id":36,"attributes":177},{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},{"data":10},{"id":180,"attributes":181},50,{"title":182,"content":183,"start_date":184,"excerpt":29,"slug":185,"end_date":10,"tags":186,"createdAt":187,"updatedAt":187,"event_categories":188,"image":192},"周末郊遊鬆一鬆：海闊天空 -- 山頂西高山","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地由山頂出發，步步高升走樓梯上西高山，沿途飽覽薄扶林水塘、數碼港，並遠眺南丫島，登頂後更可一覽無遺地觀賞維港兩岸景色。\u003Cbr\u003E\n下山時尋找維多利亞城界石及松林炮台遺址 -- 松林廢堡。\u003Cbr\u003E\n行完山，一齊去西營盤食埋晏歎埋茶先走！\u003Cbr\u003E\n今次登山路線：山頂 › 西高山 › 松林廢堡 › 香港大學（預計行山時間為2.5小時）\u003Cbr\u003E\n由中環碼頭集合坐15號巴士\u003Cbr\u003E\n日期：11\u002F3\u002F2018 星期日\u003Cbr\u003E\n時間：9:30-14:30\u003Cbr\u003E\n集合地點：中環5號碼頭巴士總站（9：30，不見即散）坐15巴士前往山頂\u003Cbr\u003E\n預計10:15到山頂\u003Cbr\u003E\n預計12:45-13:00到香港大學附近\u003Cbr\u003E\n預計食晏時間：13:30-14:30","2018-03-11","hiking1803","山頂,西高山","2018-03-11T00:00:00.000Z",{"data":189},[190],{"id":87,"attributes":191},{"name":89,"slug":90,"description":10,"createdAt":91,"updatedAt":91},{"data":10},{"pagination":194},{"page":195,"pageSize":196,"pageCount":197,"total":198},13,12,18,216],"uses":{"dependencies":["http://127.0.0.1:1337/api/events?sort=start_date%3Adesc&populate[author]=true&populate[event_categories]=true&populate[image]=true&pagination[page]=13&pagination[pageSize]=12"],"params":["page","category"]}}]}