{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"data":1,"meta":192},[2,23,42,60,74,91,103,117,131,146,160,174],{"id":3,"attributes":4},115,{"title":5,"content":6,"start_date":7,"excerpt":8,"slug":9,"end_date":10,"tags":11,"createdAt":12,"updatedAt":12,"event_categories":13,"image":22},"2020環球經濟 能否否極泰來？","\n\n🔶 全球股市崩盤式下跌，後市走勢如何？\u003Cbr\u003E\n🔶 新冠肺炎對中國以至全球經濟有何影響？\u003Cbr\u003E\n🔶 國際形勢有何變化？\u003Cbr\u003E\n🔶 石油與商品價格如何走向？\n\n日期：2020年3月15日(星期日)\u003Cbr\u003E\n時間：下午2:30-3:30\u003Cbr\u003E\n講座形式：將以Zoom Cloud Meetings軟件作現場直播\u003Cbr\u003E\n費用：全免\u003Cbr\u003E\n報告：請傳私人訊息給我們報名\u003Cbr\u003E\n備註：請先下載免費應用程式ZOOM，連結確認報名後發放\u003Cbr\u003E\n請先下載免費應用程式ZOOM(詳情請參閱附件) ，連結將於稍後發放。","2020-03-15","劉佐德全球經濟及金融研究所常務所長、香港中文大學經濟學系副教授莊太量教授","pro-chong",null,"金融經濟,股市","2020-03-15T00:00:00.000Z",{"data":14},[15],{"id":16,"attributes":17},2,{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"data":10},{"id":24,"attributes":25},114,{"title":26,"content":27,"start_date":28,"excerpt":29,"slug":30,"end_date":10,"tags":31,"createdAt":32,"updatedAt":32,"event_categories":33,"image":41},"活學營養: 抗敏抗毒 呼吸暢通","\n\n- 香港幾乎每4人就有1人鼻敏感，也有不少人患氣管敏感、哮喘等過敏症。這些敏感症是遺傳？還是其他原因誘發？\u003Cbr\u003E\n- 如何透過改善飲食及生活習慣，並運用有機營養素，舒緩甚至根治過敏症？\u003Cbr\u003E\n- 面對春夏天氣變化、空氣污染、流感高峰及新型病毒，如何強化免疫系統加以抗衡？\u003Cbr\u003E\n費用：每堂$30","2020-02-15","","health2002","鼻敏感","2020-02-15T00:00:00.000Z",{"data":34},[35],{"id":36,"attributes":37},6,{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},"活學營養","nutrition","2023-02-12T02:38:55.947Z",{"data":10},{"id":43,"attributes":44},111,{"title":45,"content":46,"start_date":47,"excerpt":29,"slug":48,"end_date":10,"tags":49,"createdAt":50,"updatedAt":50,"event_categories":51,"image":59},"新春行大運：砵甸乍山-大浪灣","\n\n❗ *緊急通知*❗\u003Cbr\u003E\n鑑於新型冠狀病毒感染確診及懷疑個案增加，顧及參加者安全，Empower 決定取消年初四(28\u002F1)的新春行山活動，敬希見諒！🙇🏻‍♀\u003Cbr\u003E\n誠盼在Empower其他活動與大家相見。\u003Cbr\u003E\n2月的活動包括：\u003Cbr\u003E\n- 2月15日（星期六）下午2:30 *＜活學營養：抗敏抗毒 呼吸暢通＞專題健康講座*\u003Cbr\u003E\n- 2月22日（星期六）下午2:30 *＜名人面對面：極深研幾 通天下志＞*，邀得殿堂級南北極專家、香港極地研究中心創辦人何建宗教授分享\u003Cbr\u003E\n- 逢星期三晚上10:00 *＜活學營養KeepFit2.0＞*，一起在線上拉筋\u003Cbr\u003E\n詳情請瀏覽：\u003Cbr\u003E\nwww.empower.hk\u003Cbr\u003E\nfacebook.com\u002Fempower.hk\u003Cbr\u003E\nEmpower謹祝大家出入平安，體健心怡！我們將繼續與大家攜手向前，Empower the Community！💪🏻💪🏻\n\n\n新年伊始，我們在小西灣的龍躍徑起步，祝願大家今年龍騰虎躍，朝氣勃勃😉\u003Cbr\u003E\n由龍躍徑起步，沿砵甸乍山郊遊徑到大浪灣，沿途180度無敵海景， 👀鳥瞰柴灣、小西灣、石澳、大浪灣風景。\u003Cbr\u003E\n初段是一段修葺良好的梯級，大約攀升約80米後，路開始沒那麼斜，到達砵甸山觀景台後會經過一段較為平坦的山路，然後開始下山。\u003Cbr\u003E\n行完山，一齊前往筲箕灣食埋晏同甜品先走！🍜\u003Cbr\u003E\n今次登山路線：小西灣海濱花園 》龍躍徑》 砵甸乍山觀景台 》 大浪灣\n（預計行山時間為2小時）\u003Cbr\u003E\n備註：初段梯級\u003Cbr\u003E\n日期：28\u002F1\u002F2020 星期二 (年初四）\u003Cbr\u003E\n時間：9:45-14:30\u003Cbr\u003E\n（預計12:00到大浪灣，大約12:45坐車到達筲箕灣）\u003Cbr\u003E\n集合地點：09:45小西灣南灣半島巴士總站\u003Cbr\u003E\n（乘車資訊：\nhttps:\u002F\u002Fzh.m.wikipedia.org\u002Fwiki\u002F小西灣（藍灣半島）公共運輸交匯處 ）","2020-01-28","hiking2001","大浪灣","2020-01-28T00:00:00.000Z",{"data":52},[53],{"id":54,"attributes":55},4,{"name":56,"slug":57,"description":10,"createdAt":58,"updatedAt":58},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"data":10},{"id":61,"attributes":62},119,{"title":63,"content":64,"start_date":65,"excerpt":29,"slug":66,"end_date":10,"tags":67,"createdAt":68,"updatedAt":68,"event_categories":69,"image":73},"周末郊遊鬆一鬆:古村水庫 - 西貢上窰及萬宜水庫西壩","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！🚶\u003Cbr\u003E\n今次我地出發西貢，由上窰村出發往萬宜水庫西壩，沿途山景海景，終點看水庫的宏偉美景！😀\u003Cbr\u003E\n行山後，一齊到西貢市飲埋茶先走🍜。\u003Cbr\u003E\n今次登山路線：\u003Cbr\u003E\n上窰巴士站-\u003E北潭涌自然教育徑-\u003E上窰民俗文物館-\u003E上窰家樂徑-\u003E萬宜水庫西壩\u003Cbr\u003E\n備註：山路及水泥路\u003Cbr\u003E\n日期：21\u002F12\u002F2019 星期六\u003Cbr\u003E\n時間：9:30-15:00\u003Cbr\u003E\n集合地點：西貢市中心巴士站94號（9:30am)\u003Cbr\u003E\n備註：一起坐巴士到上窰巴士站 （自費），預計13:30到北潭涌坐巴士回西貢市，14:00-15:00一起自費午餐。","2019-12-21","hiking1912","萬宜水庫,上窰家樂徑","2019-12-21T00:00:00.000Z",{"data":70},[71],{"id":54,"attributes":72},{"name":56,"slug":57,"description":10,"createdAt":58,"updatedAt":58},{"data":10},{"id":75,"attributes":76},110,{"title":77,"content":78,"start_date":79,"excerpt":29,"slug":80,"end_date":10,"tags":81,"createdAt":82,"updatedAt":82,"event_categories":83,"image":90},"活學營養Keep Fit工作坊2.0","\n\n四肢變得僵硬或疼痛，關節的活動範圍慢慢收細？\u003Cbr\u003E\n此工作坊針對平日無拉筋習慣的朋友，循序漸進由基礎起步，並配合核心肌肉鍛練，讓大家起動，重拾活力💥\u003Cbr\u003E\n今次Keep Fit 2.0主要做頸及肩膀的伸展拉筋，對預防和舒緩肩梗膊痛、肩周炎以至駝背大有幫助💪🏻💪🏻，最適合日理萬機的都市人😄\n\n日期：2019年12月14日\u003Cbr\u003E\n時間：上午12:45-14:00\u003Cbr\u003E\n地點：旺角家樂坊15樓安利體驗館鑽石房\u003Cbr\u003E\n費用 : $50","2019-12-14","stretching1912","拉筋,伸展","2019-12-14T00:00:00.000Z",{"data":84},[85],{"id":86,"attributes":87},5,{"name":88,"slug":89,"description":10,"createdAt":58,"updatedAt":58},"健體運動","fitness",{"data":10},{"id":92,"attributes":93},106,{"title":94,"content":95,"start_date":79,"excerpt":29,"slug":96,"end_date":10,"tags":97,"createdAt":82,"updatedAt":82,"event_categories":98,"image":102},"活學營養：活絡關節 步履輕盈","\n\n- 年紀增長，退化性關節炎隨之而來；機不離手，也令關節炎年輕化。究竟關節炎有何類型？分別有甚麼症狀呢？\u003Cbr\u003E\n- 膝蓋或其他部位發出啪啪聲，是關節退化嗎？還是只是勞損？\u003Cbr\u003E\n- 公立醫院平均需輪候3至9年才可置換關節，值得嗎？成效與風險如何？\u003Cbr\u003E\n- 怎樣透過飲食營養與運動保護關節，使我們活到老年，也能健步如飛？\n\n日期：12月14日（星期六）\u003Cbr\u003E\n時間：11:00-12:30\u003Cbr\u003E\n地點：旺角登打士街56號家樂坊15樓安利體驗館鑽石房\u003Cbr\u003E\n費用：每堂$30\u003Cbr\u003E\n名額：16人","health1912","關節健康",{"data":99},[100],{"id":36,"attributes":101},{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},{"data":10},{"id":104,"attributes":105},104,{"title":106,"content":107,"start_date":108,"excerpt":29,"slug":109,"end_date":10,"tags":110,"createdAt":111,"updatedAt":111,"event_categories":112,"image":116},"周末郊遊鬆一鬆古蹟石橋- 香港仔水塘","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地由金鐘出發，寶雲道上山，經過警隊博物館，再徐徐下山往香港仔終點。\u003Cbr\u003E\n香港仔水塘於1931年落成，內有四項法定古蹟：上水塘的大壩、大壩石橋、壩上的水掣泵房、下水塘的大壩。\u003Cbr\u003E\n行完山，一齊在香港仔食埋晏歎埋茶先走！\u003Cbr\u003E\n今次登山路線：港安醫院-\u003E寶雲道-\u003E警隊博物館-\u003E香港仔水塘（預計行山時間為3小時）\u003Cbr\u003E\n備註：輕鬆易走\u003Cbr\u003E\n日期：23\u002F11\u002F2019 星期六\u003Cbr\u003E\n時間：09:30-14:30\u003Cbr\u003E\n集合地點：金鐘港鐵站F出口，太古廣場第三期，電梯上到地面的出口等（09：30）\u003Cbr\u003E\n備註：預計13：00到香港仔，13：00-14：30一起自費午餐","2019-11-23","hiking1911","香港仔水塘","2019-11-23T00:00:00.000Z",{"data":113},[114],{"id":54,"attributes":115},{"name":56,"slug":57,"description":10,"createdAt":58,"updatedAt":58},{"data":10},{"id":118,"attributes":119},103,{"title":120,"content":121,"start_date":122,"excerpt":29,"slug":123,"end_date":10,"tags":124,"createdAt":125,"updatedAt":125,"event_categories":126,"image":130},"活學營養:明目養睛","\n\n現代人機不離手，令眼睛容易乾澀，流眼水😢，更令近視和散光加深🤓，甚至提早退化，白內障、老花越來越年輕化。\u003Cbr\u003E\n其實只要好好改善飲食及生活習慣，並懂得運用營養，即能好好改善眼睛健康😀，活到80歲，依然雙目炯炯有神！\n日期：11月9日（星期六）\u003Cbr\u003E\n時間：11:00-12:30\u003Cbr\u003E\n地點：旺角登打士街56號家樂坊15樓安利體驗館鑽石房\u003Cbr\u003E\n費用：每堂$30\u003Cbr\u003E\n名額：16人","2019-11-09","health1911","眼睛健康","2019-11-09T00:00:00.000Z",{"data":127},[128],{"id":36,"attributes":129},{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},{"data":10},{"id":132,"attributes":133},118,{"title":134,"content":135,"start_date":136,"excerpt":137,"slug":138,"end_date":10,"tags":139,"createdAt":140,"updatedAt":140,"event_categories":141,"image":145},"以夢為馬-超越挑戰．突破潛能","\n\n榮幸邀得曾任北京奧運火炬手、名符其實的公職王兼slash代表葉少康先生10月蒞臨，一次過分享他馳騁四方的馬術生涯🐎、跨越挑戰的創業路🛩️，以及近年作為天使投資者的角色👼🏻\n想突破潛能的你，萬勿錯過🤗\n\n分享嘉賓：\u003Cbr\u003E\n騁志發展基金創辦人兼主席葉少康先生, MH\u003Cbr\u003E\n2008年北京殘奧會馬術比賽香港選手\u003Cbr\u003E\n2008年北京奧運會香港區火炬手\u003Cbr\u003E\n獲香港政府頒授榮譽勳章\u003Cbr\u003E\n恒源動力有限公司、誠滙創方有限公司董事長\u003Cbr\u003E\n天使投資基金會合夥人\u003Cbr\u003E\n平等機會委員會委員\u003Cbr\u003E\n可持續發展委員會(策略工作小組委員)\n\n日期：2019年10月30日(星期三）\u003Cbr\u003E\n時間：晚上7:15-9:00\u003Cbr\u003E\n地點：九龍旺角登打士街56號家樂坊15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90 (包三文治及飲品)","2019-10-30","騁志發展基金創辦人兼主席葉少康先生, MH","nelson-yip","夢想","2019-10-30T00:00:00.000Z",{"data":142},[143],{"id":16,"attributes":144},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":147,"attributes":148},100,{"title":149,"content":150,"start_date":151,"excerpt":29,"slug":152,"end_date":10,"tags":153,"createdAt":154,"updatedAt":154,"event_categories":155,"image":159},"活學營養:擺脫糖尿 活得輕鬆","\n\n默默臨近的殺手：糖尿病為香港十大殺手之一 ，據統計每10個香港人就有一位糖尿病患者。糖尿併發症大大影響患者的生活質素，如能及早控制糖尿病就能有效減低患併發症的機會。如何透過飲食及營養降血糖呢？\n\n日期：10月7日（星期一 重陽節公眾假期）\u003Cbr\u003E\n時間：14:30-16:00\u003Cbr\u003E\n地點：旺角登打士街56號家樂坊15樓安利體驗館鑽石房\u003Cbr\u003E\n費用：每堂$30\u003Cbr\u003E\n名額：16人","2019-10-07","health1910","糖尿","2019-10-07T00:00:00.000Z",{"data":156},[157],{"id":36,"attributes":158},{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},{"data":10},{"id":161,"attributes":162},112,{"title":163,"content":164,"start_date":165,"excerpt":29,"slug":166,"end_date":10,"tags":167,"createdAt":168,"updatedAt":168,"event_categories":169,"image":173},"周末郊遊鬆一鬆：都市綠洲- 藍地水塘","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地探訪環境清幽的屯門藍地水塘。\u003Cbr\u003E\n藍地水塘建於1957年，為灌溉水塘之一，水塘雖小，但環境清幽風景如畫。\u003Cbr\u003E\n由屯門市出發，沿途風光明媚，途中可以俯瞰屯門市景色，並經過富有特色的七色彩虹欄杆。\u003Cbr\u003E\n行完山，一齊在嶺大校園內酒樓食埋晏先走！\u003Cbr\u003E\n同場加映：嶺南大學導賞（有意參加的朋友可以午餐後留下，導賞約30分鐘）\u003Cbr\u003E\n今次登山路線：屯門何福堂 》 麥徑十段 》 屯門徑二段 》 沿藍地水塘到大水壩 》 虎地下村\u003Cbr\u003E\n（預計行山時間為3小時）\u003Cbr\u003E\n備註：大部分為石屎路，當中有樓梯上落。\u003Cbr\u003E\n日期：28\u002F9\u002F2019 星期六\u003Cbr\u003E\n時間：9:30-14:30（若不午餐，預計13:00到嶺南大學）\u003Cbr\u003E\n集合地點：屯門西鐵站 A出口杯渡路（9:30）","2019-09-28","hiking1909","藍地水塘","2019-09-28T00:00:00.000Z",{"data":170},[171],{"id":54,"attributes":172},{"name":56,"slug":57,"description":10,"createdAt":58,"updatedAt":58},{"data":10},{"id":175,"attributes":176},108,{"title":177,"content":178,"start_date":179,"excerpt":29,"slug":180,"end_date":10,"tags":181,"createdAt":182,"updatedAt":182,"event_categories":183,"image":191},"讀書會主題: 心靈·勵志","\n\n雞蛋從外打破是食物，從內打破是生命；人生從外打破是壓力，從內打破是成長。\u003Cbr\u003E\n生活壓力四方八面，幸好遇壓時總有書籍能助我們向前邁進。\u003Cbr\u003E\n今次讀書會，我們特別選擇分享心靈及勵志類書籍，讓大家共同成長，同時拓展我們生命的寬度及深度。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家一起閱讀，一起分享，相互啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：12位\u003Cbr\u003E\n日期：22\u002F9\u002F2019 (星期日)\u003Cbr\u003E\n時間：11:00-13:15\u003Cbr\u003E\n地點：據點・句點＠石硤尾賽馬會創意藝術中心三樓L306D\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","2019-09-22","bookshare1909","心靈,勵志","2019-09-22T00:00:00.000Z",{"data":184},[185],{"id":186,"attributes":187},1,{"name":188,"slug":189,"description":10,"createdAt":190,"updatedAt":190},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"data":10},{"pagination":193},{"page":194,"pageSize":195,"pageCount":196,"total":197},8,12,18,216],"uses":{"dependencies":["http://127.0.0.1:1337/api/events?sort=start_date%3Adesc&populate[author]=true&populate[event_categories]=true&populate[image]=true&pagination[page]=8&pagination[pageSize]=12"],"params":["page","category"]}}]}