62766883_3953441335604489026_n_3431c1e731.jpg","aws-s3","2023-08-06T07:23:32.212Z",{"id":84,"attributes":85},158,{"title":86,"content":87,"start_date":88,"excerpt":29,"slug":89,"end_date":10,"tags":90,"createdAt":91,"updatedAt":92,"event_categories":93,"image":97},"Empower營養讀書會《營養謬誤》","\u003Cp\u003E📘Empower營養讀書會\u003Cbr\u003E營營求真，濡養思維\u003Cbr\u003E明辨謬見，告別迷誤 《營養謬誤》由在醫學界赫赫有名的袁維康醫生所著。袁醫生為牙醫醫學士、自然醫學博士及中醫醫學博士，為少數擁有3個不同領域的醫學學位的醫生，醫見獨到精闢。\u003Cbr\u003E我們榮幸邀得袁醫生的愛徒、自然療法醫生方婉君與我們一起研讀《營養謬誤》🥳。&nbsp;\u003C\u002Fp\u003E\u003Cp\u003E日期：5月2日起逢星期一\u003Cbr\u003E時間：晚上8:30-9:30\u003Cbr\u003E地點：旺角潮流特區16樓1605室Empower中心\u003Cbr\u003E📽️Zoom線上同步直播\u003Cbr\u003E費用：全免 透過每星期1️⃣小時的交流與分享，將書上知識活學活用，糾正眾多營養誤區，包括：\u003Cbr\u003E🤨高膽固醇會阻塞血管而引致心臟病？\u003Cbr\u003E🤨高鈣食物可預防骨質疏鬆？\u003Cbr\u003E🤨吃鹹的就會血壓高？ 歡迎大家邀請有意活學營養知識，過上更健康快活人生的親友一起參加🤗。\u003Cbr\u003E營養生活化，生活營養化，打造健康生活圈！💪🏻\u003C\u002Fp\u003E","2022-05-02","nutrition-book-reading-2022-may","讀書會,讀書交流會","2022-04-05T00:00:00.000Z","2023-08-06T07:22:22.158Z",{"data":94},[95],{"id":36,"attributes":96},{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},{"data":98},{"id":99,"attributes":100},23,{"name":101,"alternativeText":10,"caption":10,"width":102,"height":102,"formats":103,"hash":124,"ext":50,"mime":53,"size":125,"url":126,"previewUrl":10,"provider":81,"provider_metadata":10,"createdAt":127,"updatedAt":127},"cover.jpg",2400,{"large":104,"small":109,"medium":114,"thumbnail":119},{"ext":50,"url":105,"hash":106,"mime":53,"name":107,"path":10,"size":108,"width":56,"height":56},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_cover_70c8aa9392.jpg","large_cover_70c8aa9392","large_cover.jpg",127.18,{"ext":50,"url":110,"hash":111,"mime":53,"name":112,"path":10,"size":113,"width":63,"height":63},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_cover_70c8aa9392.jpg","small_cover_70c8aa9392","small_cover.jpg",42.5,{"ext":50,"url":115,"hash":116,"mime":53,"name":117,"path":10,"size":118,"width":57,"height":57},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fmedium_cover_70c8aa9392.jpg","medium_cover_70c8aa9392","medium_cover.jpg",78.28,{"ext":50,"url":120,"hash":121,"mime":53,"name":122,"path":10,"size":123,"width":77,"height":77},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fthumbnail_cover_70c8aa9392.jpg","thumbnail_cover_70c8aa9392","thumbnail_cover.jpg",6.5,"cover_70c8aa9392",517.34,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fcover_70c8aa9392.jpg","2023-08-06T07:22:14.550Z",{"id":129,"attributes":130},169,{"title":131,"content":132,"start_date":133,"excerpt":134,"slug":135,"end_date":10,"tags":29,"createdAt":136,"updatedAt":137,"event_categories":138,"image":142},"傷逝：這麼遠，那麼近！","\u003Cp\u003E過去數月，香港疫情嚴峻，染疫和死亡人數直線上升，歿者包括體弱長者、年輕人及幼童。不少人感遺憾的是在彌留之際，家人未能陪伴在旁😞。 分享重點：\u003Cbr\u003E💡闡述《漢語大詞典》：「傷逝，悲傷地懷念去世的人。」\u003Cbr\u003E💡如何處理負面情緒\u003Cbr\u003E💡重新連結，維持親密關係，創造幸福&nbsp;\u003C\u002Fp\u003E\u003Cp\u003E日期：4月26日（二）\u003Cbr\u003E時間：中午12:45至1:45\u003Cbr\u003E形式：Zoom直播\u003Cbr\u003E費用：$40\u003Cbr\u003E歡迎Inbox索取連結，謝謝！\u003C\u002Fp\u003E","2022-04-26","陳呂令意校長--前中學及小學直資學校校長，現任大學講師、家長教育專家、生命教育及生涯規劃教練","lilian-chan-220426","2023-02-12T03:35:51.750Z","2023-08-06T07:20:25.151Z",{"data":139},[140],{"id":16,"attributes":141},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":143},{"id":144,"attributes":145},22,{"name":146,"alternativeText":10,"caption":10,"width":102,"height":147,"formats":148,"hash":171,"ext":150,"mime":153,"size":172,"url":173,"previewUrl":10,"provider":81,"provider_metadata":10,"createdAt":174,"updatedAt":174},"1.png",1800,{"large":149,"small":156,"medium":161,"thumbnail":166},{"ext":150,"url":151,"hash":152,"mime":153,"name":154,"path":10,"size":155,"width":56,"height":57},".png","https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_1_e5beef2bf6.png","large_1_e5beef2bf6","image\u002Fpng","large_1.png",458.84,{"ext":150,"url":157,"hash":158,"mime":153,"name":159,"path":10,"size":160,"width":63,"height":64},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_1_e5beef2bf6.png","small_1_e5beef2bf6","small_1.png",156.78,{"ext":150,"url":162,"hash":163,"mime":153,"name":164,"path":10,"size":165,"width":57,"height":70},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fmedium_1_e5beef2bf6.png","medium_1_e5beef2bf6","medium_1.png",289.73,{"ext":150,"url":167,"hash":168,"mime":153,"name":169,"path":10,"size":170,"width":76,"height":77},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fthumbnail_1_e5beef2bf6.png","thumbnail_1_e5beef2bf6","thumbnail_1.png",39.27,"1_e5beef2bf6",363.31,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002F1_e5beef2bf6.png","2023-08-06T07:20:18.375Z",{"id":176,"attributes":177},159,{"title":178,"content":179,"start_date":180,"excerpt":29,"slug":181,"end_date":10,"tags":182,"createdAt":183,"updatedAt":183,"event_categories":184,"image":192},"21日 動起來！Let's Move！","\n\n🎉明天7\u002F3啟動啦🎉\n🤷‍♂️日日留在家，就快宅到筋都緊？\n💁歡迎參加這21天活動，循序漸進地動起來！\n⭐ 輕鬆沒負擔，不用刻意換衫\n⭐ 每次只是2-7分鐘\n由星期一7\u002F3開始，也可以隨時插班，非常彈性。\n如欲了解更多，歡迎PM查詢😉\n👏👏歡迎邀請親友一起參與，每天ZOOM快閃7️⃣分鐘，輕輕鬆鬆，一齊動動，好快就夠鐘😉","2022-03-07","21-days-lets-move-march","在家運動","2022-03-06T00:00:00.000Z",{"data":185},[186],{"id":187,"attributes":188},5,{"name":189,"slug":190,"description":10,"createdAt":191,"updatedAt":191},"健體運動","fitness","2023-02-12T02:38:55.946Z",{"data":10},{"id":194,"attributes":195},155,{"title":196,"content":197,"start_date":198,"excerpt":199,"slug":200,"end_date":10,"tags":201,"createdAt":202,"updatedAt":202,"event_categories":203,"image":207},"創業家解鎖：無懼變化而變通 堅守原則致成功","\n\n分享重點：\u003Cbr\u003E\n💡 當日「唔認識寵物行業」下創業， Paul的創業眼光和心態怎樣？\u003Cbr\u003E\n💡 寵物店成行成市，能突圍而出並成為全港最大的寵物連鎖店，Paul做了甚麼重要策略？\u003Cbr\u003E\n💡 面對疫情不斷和創新科技概念的湧現，Paul作爲寵物行業的領航者及擁有豐富經驗的創業者，怎樣為未來定位？\u003Cbr\u003E\nPaul更會解構為何他在內地有工廠和辦事處，不聘請香港人打理，也可以兩年不用北上？🤔\u003Cbr\u003E\n他又如何看區塊鏈NFT與元宇宙Metaverse的趨勢？🤔\u003Cbr\u003E\n歡迎邀請親友一起實體或線上出席！💪🏻🤗\n\nPowered by Empower\u003Cbr\u003E\nwww.Empower.hk\u003Cbr\u003E\nFacebook.com\u002FEmpower.hk\u003Cbr\u003E\nYouTube.com\u002FEmpowerhk","2022-02-20","全港最大寵物用品連鎖店Q-pets創辦人、創業家葉煜明先生Paul","paul-yip-220220","創業","2022-02-20T00:00:00.000Z",{"data":204},[205],{"id":16,"attributes":206},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":77,"attributes":209},{"title":210,"content":211,"start_date":212,"excerpt":213,"slug":214,"end_date":10,"tags":215,"createdAt":216,"updatedAt":216,"event_categories":217,"image":221},"體有憾 心無缺 生命鬥士活出精彩每一天","\n\n1月名人面對面，Empower榮幸邀得龔黃螢敏女士Linda，為我們分享她不屈不撓的人生奮鬥歷程！💪🏻 \u003Cbr\u003E\n❤️Linda自2007年起在聖雅各福群會擔任婦女義工，長達11年。\u003Cbr\u003E\n❤️2009年不幸發現患上晚期癌症，但依然出任「寄養家庭」家長，10年來照顧31名缺乏家庭溫暖的嬰孩。\u003Cbr\u003E\n❤️2014年起開辦「愛心二手站」，鼓勵社會人士捐出物資，送贈有需要的基層家庭。\u003Cbr\u003E\n❤️12年來接受了218針標靶治療，矢志在抗癌路上幫助同行者與有需要的人。\n\n分享重點：\u003Cbr\u003E\n💡 三子女求學期間，短時間發現自己先後患上乳癌及甲狀腺癌，Linda如何面對？\u003Cbr\u003E\n💡 身患晚期癌症，依然成為緊急寄養家庭照顧嬰孩，是甚麼動力驅使Linda擔當這不一樣的義工？\u003Cbr\u003E\n💡 「愛心二手站」的理念與宗旨為何？與其他慈善義賣店有何分別？\n\n歡迎邀請親友一起實體或線上參與，一同提升正能量！\u003Cbr\u003E\n如欲出席，敬請私訊我們報名留座。謝謝！🤗\n\nPowered by Empower \u003Cbr\u003E\nwww.Empower.hk \u003Cbr\u003E\nFacebook.com\u002FEmpower.hk\nYouTube.com\u002FEmpowerhk ","2022-01-15","龔黃螢敏女士Linda","linda-220115","再生勇士","2022-01-15T00:00:00.000Z",{"data":218},[219],{"id":16,"attributes":220},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":223,"attributes":224},165,{"title":225,"content":226,"start_date":227,"excerpt":29,"slug":228,"end_date":10,"tags":229,"createdAt":230,"updatedAt":230,"event_categories":231,"image":235},"減壓伸展工作坊-實體班","\n\n🌟伸展拉筋，不但可以促進血液循環，消除疲勞，更有助減壓和入眠呢！\u003Cbr\u003E\n透過簡單而有效的動作，齊齊鬆一鬆，減減壓！\u003Cbr\u003E\n日期：12月13日 (星期一）\u003Cbr\u003E\n時間：11:00-12:30\u003Cbr\u003E\n地點：旺角登打士街家樂坊15樓安利體驗館會議室C\u003Cbr\u003E\n費用 : $80\u002F堂（請自備瑜珈墊）\u003Cbr\u003E\n備註：\u003Cbr\u003E\n1. 參加者須全程戴口罩\u003Cbr\u003E\n2. 可以以$10租用瑜珈墊一張\u003Cbr\u003E\n4. 報名請PM訊息給我們查詢報名詳情","2021-12-13","stretching-workshop-dec13","伸展,拉筋","2021-12-13T00:00:00.000Z",{"data":232},[233],{"id":187,"attributes":234},{"name":189,"slug":190,"description":10,"createdAt":191,"updatedAt":191},{"data":10},{"id":237,"attributes":238},154,{"title":239,"content":240,"start_date":241,"excerpt":242,"slug":243,"end_date":10,"tags":244,"createdAt":245,"updatedAt":245,"event_categories":246,"image":250},"善用親子調解 家庭融洽和諧","\n\n主講嘉賓：梁淑瑜小姐Fish\u003Cbr\u003E\n香港十大親子調解專家、香港家庭調解協會總幹事、註冊社工，主講逾600場公開專題講座及培訓工作坊，屢獲粵港澳媒體採訪報道\n\n分享重點：\u003Cbr\u003E\n💡解構Fish獨創的「親子調解」的適用範疇\u003Cbr\u003E\n💡如何有系統和有步驟地解決家庭衝突，達致全方位家庭和諧？\u003Cbr\u003E\n💡由小朋友讀書與生活習慣引起的衝突，或代溝導致的青少年與家長不和，親子調解如何幫得上忙？\n\nPowered by Empower\u003Cbr\u003E\nwww.Empower.hk\u003Cbr\u003E\nFacebook.com\u002FEmpower.hk\u003Cbr\u003E\nYouTube.com\u002FEmpowerhk","2021-12-10","香港十大親子調解專家、香港家庭調解協會總幹事、註冊社工梁淑瑜小姐Fish","fish-leung-communication","調解,親子關係,溝通技巧","2021-12-10T00:00:00.000Z",{"data":247},[248],{"id":16,"attributes":249},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":252,"attributes":253},163,{"title":254,"content":255,"start_date":256,"excerpt":29,"slug":257,"end_date":10,"tags":258,"createdAt":259,"updatedAt":259,"event_categories":260,"image":268},"生命密碼再探","\n\n❤️ 認識自己的性格特質，更瞭解自己，更瞭解他人\u003Cbr\u003E\n❤️ 命運數的組合？命運數以外的數字？\u003Cbr\u003E\n❤️ 如何補足自己性格的不足？\n\n日期：2021年11月27日（星期六）\u003Cbr\u003E\n時間：上午11:30-13:00\u003Cbr\u003E\n地點：旺角家樂坊15樓安利體驗館會議室C\u003Cbr\u003E\n費用 : $50\u003Cbr\u003E\n報名方式：請inbox訊息給我們報名及索取付款詳情","2021-11-17","discover-numerology-2","生命密碼,性格分析","2021-11-27T00:00:00.000Z",{"data":261},[262],{"id":263,"attributes":264},3,{"name":265,"slug":266,"description":10,"createdAt":267,"updatedAt":267},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"data":10},{"id":270,"attributes":271},160,{"title":272,"content":273,"start_date":274,"excerpt":275,"slug":276,"end_date":10,"tags":277,"createdAt":278,"updatedAt":278,"event_categories":279,"image":283},"兩岸三地書店形態的發展","\n\n疫情改變消費通路，網絡經濟大爆發，兩岸三地書店形態也有著翻天覆地的改變😉。\n\n11月名人面對面，Empower榮幸邀得熟諳中、港、台三地書店演進與轉型的陳萬雄博士擔任主講嘉賓🤗。陳博士曾任香港商務印書館總經過理兼總編輯、聯合出版集團有限公司副董事長兼總裁，亦是著名的出版家。\n\n💡大家不妨想想，甚麼書店才能令你流連忘返？\u003Cbr\u003E\n💡O2O書店如何帶來閱讀新體驗？\u003Cbr\u003E\n💡你心中的夢想書房，又是甚麼樣子？","2021-11-06","曾任香港商務印書館總經理兼總編輯、聯合出版集團有限公司副董事長兼總裁，亦是著名的出版家陳萬雄博士","professor-chan-book","出版商,閱讀,文化","2021-11-06T00:00:00.000Z",{"data":280},[281],{"id":16,"attributes":282},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":285,"attributes":286},149,{"title":287,"content":288,"start_date":289,"excerpt":29,"slug":290,"end_date":10,"tags":291,"createdAt":292,"updatedAt":292,"event_categories":293,"image":297},"生命密碼初探","\n\n❤️ 認識自己的性格特質\u003Cbr\u003E\n❤️ 更瞭解自己，更瞭解他人\u003Cbr\u003E\n❤️ 增進有效溝通\n\n日期：2021年10月14日（星期四，假期）\u003Cbr\u003E\n時間：下午2:00-3:15\u003Cbr\u003E\n地點：旺角家樂坊15樓安利體驗館會議室B\u003Cbr\u003E\n費用 : $50\u003Cbr\u003E\n報名優惠：以優惠價$80一併報名當天3:30-4:45的血型飲食法\u003Cbr\u003E\n報名方式：請inbox訊息給我們報名及索取付款詳情","2021-10-14","discovering-numerology","生命密碼,自我探索","2021-10-14T00:00:00.000Z",{"data":294},[295],{"id":263,"attributes":296},{"name":265,"slug":266,"description":10,"createdAt":267,"updatedAt":267},{"data":10},{"pagination":299},{"page":187,"pageSize":300,"pageCount":301,"total":302},12,18,216],"uses":{"dependencies":["http://127.0.0.1:1337/api/events?sort=start_date%3Adesc&populate[author]=true&populate[event_categories]=true&populate[image]=true&pagination[page]=5&pagination[pageSize]=12"],"params":["page","category"]}}]}