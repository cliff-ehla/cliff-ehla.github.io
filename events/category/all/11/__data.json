{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"data":1,"meta":194},[2,23,42,60,75,93,107,121,136,150,164,179],{"id":3,"attributes":4},94,{"title":5,"content":6,"start_date":7,"excerpt":8,"slug":9,"end_date":10,"tags":11,"createdAt":12,"updatedAt":12,"event_categories":13,"image":22},"獅子山下 九龍半島之蛻變","\n\n丁博士笑言：「你住在哪裡？學校在哪裡？教會又在哪裡？如果都腳踏實地，你真係叻喇！」\u003Cbr\u003E\n丁博士將以百年歷史為經緯，細說曾被稱為「不毛之地」，至今已成為全球人口密度最高地區的九龍半島的發展歷程和填海史！","2019-03-22","香港歷史博物館前總館長、香港中文大學歷史系客席教授丁新豹博士","professor-ding",null,"香港歷史,填海","2019-03-22T00:00:00.000Z",{"data":14},[15],{"id":16,"attributes":17},2,{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"data":10},{"id":24,"attributes":25},83,{"title":26,"content":27,"start_date":28,"excerpt":29,"slug":30,"end_date":10,"tags":31,"createdAt":32,"updatedAt":32,"event_categories":33,"image":41},"讀書會：歷史與未來","\n\n歷史塑造了我們的科技、政治和社會，也塑造了我們的思想和夢想。現實彷彿是自然又理所當然。\u003Cbr\u003E\n今次的讀書會，讓我們一起分享讓人們從過去走到現在的事，以不同角度閱讀現在，思考不一樣的未來。\u003Cbr\u003E\n同場加映：《據點。句點》藝術空間舉辦的展覽 — 《無法取得位置 Nothing Can Come Closer》，詳情見 https:\u002F\u002Fwww.facebook.com\u002Fevents\u002F376729836439046\u002F?ti=icl\n\n愛書人：12位\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n分享書藉包括：\u003Cbr\u003E\n－\"Factfulness: Ten Reasons We're Wrong About The World - And Why Things Are Better Than You Think\"- Hans Rosling\u003Cbr\u003E\n－《從中國歷史來看中國民族性及中國文化》錢穆\u003Cbr\u003E\n－《讀史觀勢》張建雄\u003Cbr\u003E\n－《第二次世界大戰史》馬丁・吉爾伯特\u003Cbr\u003E\n日期：10\u002F3\u002F2019 (星期六)\u003Cbr\u003E\n時間：\u003Cbr\u003E\n12:00-14:00（讀書會）\u003Cbr\u003E\n14:00-15:00（展覽導賞）\u003Cbr\u003E\n地點：據點。句點 (石硤尾賽馬會創意藝術中心3樓L306D Floating Project)\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","2019-03-10","","bookshare1903","歷史","2019-03-10T00:00:00.000Z",{"data":34},[35],{"id":36,"attributes":37},1,{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"data":10},{"id":43,"attributes":44},79,{"title":45,"content":46,"start_date":47,"excerpt":29,"slug":48,"end_date":10,"tags":49,"createdAt":50,"updatedAt":50,"event_categories":51,"image":59},"活學營養：護肝利膽・理氣明目","\n\n春天屬木，人體的五臟之中肝也是屬木，故春季是最適合養肝之時。\u003Cbr\u003E\n香港人普遍晚睡，加上食無定時，肝膽首當其衝受累，中年以後不少人更容易積聚膽石。我們如何可在繁忙的生活中護肝養膽？坊間的排膽石之法可靠嗎？\n\n日期：2019年2月23日(六) 11:00 – 12:30\u003Cbr\u003E\n地點：旺角登打士街56號家樂坊15樓安利體驗館鑽石會議室\u003Cbr\u003E\n費用：每堂$30\u003Cbr\u003E\n名額：16人","2019-02-23","health1902","膽石","2019-02-02T00:00:00.000Z",{"data":52},[53],{"id":54,"attributes":55},6,{"name":56,"slug":57,"description":10,"createdAt":58,"updatedAt":58},"活學營養","nutrition","2023-02-12T02:38:55.947Z",{"data":10},{"id":61,"attributes":62},72,{"title":63,"content":64,"start_date":65,"excerpt":66,"slug":67,"end_date":10,"tags":68,"createdAt":69,"updatedAt":69,"event_categories":70,"image":74},"品味咖啡 探索人生","\n\n主講嘉賓文桂芳博士(Dr May Man)簡介：\u003Cbr\u003E\n香港咖啡業界首位擔任「國際咖啡師監考官」的女性，在政府、私營及教育機構擔任咖啡講座及培訓課程導師，亦是《沖上雲霄 II》、《 愛‧回家》、《 On Call 36 小時 II》、《分手100次》等劇集和電影的咖啡顧問\n\nDr Man 將分享其曲折起伏的創業經歷，並帶領大家探索咖啡的個性，品味多采的人生！\n","2019-02-16","文桂芳博士(Dr May Man)","dr-man","咖啡,創業","2019-02-16T00:00:00.000Z",{"data":71},[72],{"id":16,"attributes":73},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":76,"attributes":77},73,{"title":78,"content":79,"start_date":80,"excerpt":29,"slug":81,"end_date":10,"tags":82,"createdAt":83,"updatedAt":83,"event_categories":84,"image":92},"新春行大運：鴨仔山","\n\n新一年繼續步步高陞，今次我們探訪將軍澳區居民的後花園 -- 鴨仔山！\u003Cbr\u003E\n鴨仔山高約152米，上坡幅度平緩適中；浴途俯瞰牛尾海，途經舊無線電線城，以香港科技大學作終點。\u003Cbr\u003E\n行完山，一齊在科技大學校園食埋晏先走！🍜\u003Cbr\u003E\n今次登山路線：寶琳地鐵站 》鴨仔山 》 清水灣道 》 銀影路 》 香港科技大學\u003Cbr\u003E\n（預計行山時間為1.5小時）\u003Cbr\u003E\n備註：大部分為石屎路，當中有樓梯上落。\u003Cbr\u003E\n日期：9\u002F2\u002F2019 星期六 (年初五)\u003Cbr\u003E\n時間：9:30-13:00（若不午餐，預計12:00到科技大學）\u003Cbr\u003E\n集合地點：寶琳地鐵站B出口","2019-02-09","hiking1902","鴨仔山,清水灣道,香港科技大學","2019-02-09T00:00:00.000Z",{"data":85},[86],{"id":87,"attributes":88},4,{"name":89,"slug":90,"description":10,"createdAt":91,"updatedAt":91},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"data":10},{"id":94,"attributes":95},77,{"title":96,"content":97,"start_date":98,"excerpt":29,"slug":99,"end_date":10,"tags":100,"createdAt":101,"updatedAt":101,"event_categories":102,"image":106},"活學營養：驅寒保暖・大寒養生","\n\n大寒為陰陽交接的節氣。大寒(2019年為1月20日）養生養得好，冬天不怕凍，全年身體好！\u003Cbr\u003E\n－大寒氣候特點\u003Cbr\u003E\n－飲食、營養及生活養生妙法\u003Cbr\u003E\n－簡易拉筋及穴位拍打\n\n日期：2019年1月12日(六)及1月27日(日)\u003Cbr\u003E\n時間：下午3：00 - 4：30\u003Cbr\u003E\n地點：旺角登打士街56號家樂坊15樓安利體驗館鑽石房\u003Cbr\u003E\n費用：每堂$30\u003Cbr\u003E\n名額：16人\u003Cbr\u003E\n備註：兩課獨立內容，可單獨報名","2019-01-27","health1901","養生,大寒","2019-01-27T00:00:00.000Z",{"data":103},[104],{"id":54,"attributes":105},{"name":56,"slug":57,"description":10,"createdAt":58,"updatedAt":58},{"data":10},{"id":108,"attributes":109},75,{"title":110,"content":111,"start_date":112,"excerpt":29,"slug":113,"end_date":10,"tags":114,"createdAt":115,"updatedAt":115,"event_categories":116,"image":120},"周末郊遊鬆一鬆：新年步步高陞 -- 細味纜車徑","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地由中環出發，經中區自然徑（纜車徑）沿纜車軌道而上，回顧殖民時代的點滴，觀賞英式設計的纜車站，途經政務司司長官邸，並飽覽維港兩岸景色，以山頂廣場作終點。\n\n行完山，一齊坐車去灣仔，食埋晏歎埋茶先走！\u003Cbr\u003E\n今次登山路線： 中區自然徑（纜車徑及漆咸徑）-\u003E 白加道 -\u003E 山頂纜車站（預計行山時間為3小時）\u003Cbr\u003E\n由山頂往灣仔約需20分鐘車程。\u003Cbr\u003E\n備註：水泥路面，緩步上山\u003Cbr\u003E\n日期：20\u002F1\u002F2019 星期日\u003Cbr\u003E\n時間：9:30-15:30\u003Cbr\u003E\n集合地點： 長江集團中心正門\u003Cbr\u003E\n由中環港鐵站 J2出口約行5分鐘（9:30，不見即散）\u003Cbr\u003E\n預計最遲1點到灣仔午飯","2019-01-20","hiking1901","纜車徑,山頂","2019-01-20T00:00:00.000Z",{"data":117},[118],{"id":87,"attributes":119},{"name":89,"slug":90,"description":10,"createdAt":91,"updatedAt":91},{"data":10},{"id":122,"attributes":123},70,{"title":124,"content":125,"start_date":126,"excerpt":127,"slug":128,"end_date":10,"tags":129,"createdAt":130,"updatedAt":130,"event_categories":131,"image":135},"解構中美貿易戰－烽煙四起・還是戰火平息？","\n\n主講嘉賓： 莊太量教授\u003Cbr\u003E\n(香港中文大學經濟學系副教授、劉佐德全球經濟及金融研究所常務所長)\u003Cbr\u003E\n－香港中文大學經濟學學士、美國羅徹斯特大 學(University of Rochester)經濟學博士\u003Cbr\u003E\n－ 著有《人生煉金術的7大抉擇》及600餘篇論 文,發表於國際學術期刊及中港報章\u003Cbr\u003E\n－ 曾任世界銀行項目顧問、香港特區政府中央 政策組非全職顧問、標凖工時委員會委員。 現為香港特區政府交通諮詢委員會、土地及 建設諮詢委員會、中小企業發展支援基金及 發展品牌、升級轉型及拓展內銷市場的專項基金評審委員會委員、香港學術及職業資歷評審局專家小組委員、亞太研究所金融市場研究計劃主任，以及多份國際期刊的編輯委員\n\n日期：2019年1月19日(星期六)\u003Cbr\u003E\n時間：晚上7:15-9:30\u003Cbr\u003E\n地點：九龍旺角登打士街56號柏裕商業中心15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90一位 (包括三文治及飲品)","2019-01-19","香港中文大學經濟學系副教授-莊太量教授","professor-chong","經濟,香港股市,香港樓市,投資,金融經濟","2019-01-19T00:00:00.000Z",{"data":132},[133],{"id":16,"attributes":134},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":137,"attributes":138},74,{"title":139,"content":140,"start_date":141,"excerpt":29,"slug":142,"end_date":10,"tags":143,"createdAt":144,"updatedAt":144,"event_categories":145,"image":149},"讀書會主題：健康·養生","\n正所謂，年少不養生，老來養醫生。\u003Cbr\u003E\n壓大很大，糖衣很美。餐廳充斥著高油高脂的美食，高效的社會同時亦帶來高壓。我們並不能抱著「今朝有酒今朝醉，哪管他朝吊鹽水」的心態。\u003Cbr\u003E\n健康，既指肉體上的，亦指心靈上的健康。\u003Cbr\u003E\n達到身心靈的平衡不僅使我們身體健康，亦促使我們成就完滿的人生。\u003Cbr\u003E\n今次讀書會，我們特別選擇了分享健康養生類書籍，共同朝向身心靈整體健康的目標前進。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家一起閱讀，一起分享，相互啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n日期：6\u002F01\u002F2019 (星期日)\u003Cbr\u003E\n時間：14:00-16:00\u003Cbr\u003E\n地點：Coffee Lover (觀塘偉業街171號偉業工業大廈3\u002FF B室)\u003Cbr\u003E\n牛頭角MTR B出口，悅景海景酒店側\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","2019-01-13","bookshare1901","健康","2019-01-13T00:00:00.000Z",{"data":146},[147],{"id":36,"attributes":148},{"name":38,"slug":39,"description":10,"createdAt":40,"updatedAt":40},{"data":10},{"id":151,"attributes":152},63,{"title":153,"content":154,"start_date":155,"excerpt":29,"slug":156,"end_date":10,"tags":157,"createdAt":158,"updatedAt":158,"event_categories":159,"image":163},"周末郊遊鬆一鬆: 香港千島湖- 大欖涌水塘","\n\n侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地由元朗楊屋村出發，經黃泥墩水塘，沿著麥理浩徑十段，行至大檻掃管笏作終點。\u003Cbr\u003E\n沿途風景優美，飽覧有香港千島湖之稱的大欖涌水塘！\u003Cbr\u003E\n行完山，一齊坐車去三聖村，食埋晏歎埋茶先走！\u003Cbr\u003E\n今次登山路線：大棠楊屋村-\u003E麥理浩徑十段-\u003E掃管笏（預計行山時間為3小時）\u003Cbr\u003E\n備註：\n由朗屏集合坐K66巴士預計半小時，由掃管笏往黃金海岸約需20分鐘。\n水泥路面，輕鬆易走\n日期：8\u002F12\u002F2018 星期六\u003Cbr\u003E\n時間：9:30-15:30\u003Cbr\u003E\n集合地點：朗屏港鐵站B出口（9：30，不見即散）\u003Cbr\u003E\n預計最遲2點會到三聖村午飯","2018-12-08","hiking1812","大欖涌水塘,千島湖","2018-12-08T00:00:00.000Z",{"data":160},[161],{"id":87,"attributes":162},{"name":89,"slug":90,"description":10,"createdAt":91,"updatedAt":91},{"data":10},{"id":165,"attributes":166},80,{"title":167,"content":168,"start_date":169,"excerpt":170,"slug":171,"end_date":10,"tags":172,"createdAt":173,"updatedAt":173,"event_categories":174,"image":178},"年青創業＋網絡營銷新趨勢","\n\n主講嘉賓：超凡網絡 (Guru Online) 聯合創辦人兼執行董事尹瑋婷小姐(Karin)\u003Cbr\u003E\n－ 2004年於香港中文大學工商管理學系畢業，先後投身旅遊業及鐘錶界\u003Cbr\u003E\n－ 2007年看準數碼營銷的商機，與幾位朋友合作成立Guru Online，為不同機構及品牌提供形象塑造及社交媒體的營銷服務，客戶包括國泰航空、海洋公園、三星等\u003Cbr\u003E\n－ 近年主力開拓中國大陸市場，協助各省市政府及旅遊委出海，曾參與領導南京青年奧林匹克運動會歷史上首個網絡火炬傳遞、中國首個旅遊外交項目杭州環球行等\u003Cbr\u003E\n－ 2015年公司於創業板上市，成為廣告業界的一時佳話\n\n日期：2018年11月30日(星期五)\u003Cbr\u003E\n時間：晚上7:15-9:30\u003Cbr\u003E\n地點：九龍旺角登打士街56號柏裕商業中心15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90一位 (包括三文治及飲品)","2018-11-30","超凡網絡Guru Online聯合創辦人兼執行董事尹瑋婷小姐Karin","karin","創業,網絡營銷","2018-11-30T00:00:00.000Z",{"data":175},[176],{"id":16,"attributes":177},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"id":180,"attributes":181},71,{"title":182,"content":183,"start_date":184,"excerpt":185,"slug":186,"end_date":10,"tags":187,"createdAt":188,"updatedAt":188,"event_categories":189,"image":193},"睛彩人生","\n\n分享嘉賓：Dr. Leonard YUEN 源旭眼科專科醫生\u003Cbr\u003E\n-美國哈佛大學碩士畢業\u003Cbr\u003E\n-受訓並執業於英國、美國、新加坡、香港\u003Cbr\u003E\n-熱心慈善活動，如奧比斯、老有所醫義診計劃和其他義工服務\n\n分享重點：\u003Cbr\u003E\n眼科醫學的最新科技發展\u003Cbr\u003E\n慈善活動的感懷與得著\n\n日期：2018年11月17日(星期六)\u003Cbr\u003E\n時間：晚上7:15-9:30\u003Cbr\u003E\n地點：九龍旺角登打士街56號柏裕商業中心15樓安利體驗館會議室A\u003Cbr\u003E\n費用：$90一位 (包括三文治及飲品)","2018-11-17","源旭眼科專科醫生","dr-yuen","眼科","2018-11-17T00:00:00.000Z",{"data":190},[191],{"id":16,"attributes":192},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":21},{"data":10},{"pagination":195},{"page":196,"pageSize":197,"pageCount":198,"total":199},11,12,18,216],"uses":{"dependencies":["http://127.0.0.1:1337/api/events?sort=start_date%3Adesc&populate[author]=true&populate[event_categories]=true&populate[image]=true&pagination[page]=11&pagination[pageSize]=12"],"params":["page","category"]}}]}