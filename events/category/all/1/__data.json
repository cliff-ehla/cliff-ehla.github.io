onaws.com\u002Fthumbnail_1_e011d79ce2.jpeg","thumbnail_1_e011d79ce2","thumbnail_1.jpeg","1_e011d79ce2",277.48,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002F1_e011d79ce2.jpeg","2025-11-04T09:26:08.141Z",{"id":548,"attributes":549},205,{"title":550,"content":551,"start_date":552,"excerpt":553,"slug":554,"end_date":552,"tags":7,"createdAt":555,"updatedAt":555,"event_categories":556,"image":560},"與菌同行","\u003Cp\u003E《食材探源 × 手作烹飪 × 營養科學》系列&nbsp;\u003Cbr\u003E動手連結食物，發掘食物中的營養力量！\u003C\u002Fp\u003E\u003Cp\u003E活動頭炮：與菌同行\u003Cbr\u003E⭐️ 手作零酵母小圓餅：體驗徒手搓揉麵團的樂趣，感受食物的原始力量\u003Cbr\u003E⭐️ 探索「菌」世界：認識日常接觸的微生物，了解它們與健康的密切關聯。&nbsp;\u003Cbr\u003E⭐️ 健康全面升級：從增強身體好菌開始，提升腸道健康、免疫系統、情緒商數、認知功能，由內而外煥發健康光彩！\u003C\u002Fp\u003E\u003Cp\u003E日期：9月20日（六）\u003Cbr\u003E時間：上午11:00至13:00\u003Cbr\u003E地點：油麻地登打士街家樂坊15樓廚藝教室\u003Cbr\u003E費用：$120\u002F位 &nbsp;\u003C\u002Fp\u003E\u003Cp\u003E小朋友也可以一起體驗徒手揉搓麵團🥳歡迎垂詢\u003C\u002Fp\u003E","2025-09-20","《食材探源 × 手作烹飪 × 營養科學》系列 ","food-good-bacteria","2025-09-14T07:35:34.424Z",{"data":557},[558],{"id":76,"attributes":559},{"name":78,"slug":79,"description":7,"createdAt":80,"updatedAt":80},{"data":561},{"id":562,"attributes":563},74,{"name":522,"alternativeText":7,"caption":7,"width":30,"height":564,"formats":565,"hash":586,"ext":33,"mime":36,"size":587,"url":588,"previewUrl":7,"provider":64,"provider_metadata":7,"createdAt":589,"updatedAt":589},1350,{"large":566,"small":571,"medium":576,"thumbnail":581},{"ext":33,"url":567,"hash":568,"mime":36,"name":527,"path":7,"size":569,"width":570,"height":39},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_1_ef796d8456.jpeg","large_1_ef796d8456",141.76,800,{"ext":33,"url":572,"hash":573,"mime":36,"name":532,"path":7,"size":574,"width":575,"height":46},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_1_ef796d8456.jpeg","small_1_ef796d8456",50.37,400,{"ext":33,"url":577,"hash":578,"mime":36,"name":537,"path":7,"size":579,"width":580,"height":40},"https:\u002F\u002Fe