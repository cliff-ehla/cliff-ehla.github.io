{"type":"data","nodes":[{"type":"data","data":[{"categories":1,"event_categories":27},[2,9,15,21],{"id":3,"attributes":4},1,{"slug":5,"name":6,"description":7,"createdAt":8,"updatedAt":8},"nutrition","營養隨筆",null,"2023-02-12T02:39:02.691Z",{"id":10,"attributes":11},2,{"slug":12,"name":13,"description":7,"createdAt":14,"updatedAt":14},"reflection","感悟隨筆","2023-02-12T02:39:02.692Z",{"id":16,"attributes":17},3,{"slug":18,"name":19,"description":7,"createdAt":20,"updatedAt":20},"fitness","運動筆記","2023-02-12T02:39:02.697Z",{"id":22,"attributes":23},4,{"slug":24,"name":25,"description":7,"createdAt":26,"updatedAt":26},"spiritual","心靈勵志","2023-02-12T02:39:02.698Z",[28,33,38,43,47,52,58],{"id":3,"attributes":29},{"name":30,"slug":31,"description":7,"createdAt":32,"updatedAt":32},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"id":16,"attributes":34},{"name":35,"slug":36,"description":7,"createdAt":37,"updatedAt":37},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":22,"attributes":39},{"name":40,"slug":41,"description":7,"createdAt":42,"updatedAt":42},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"id":44,"attributes":45},5,{"name":46,"slug":18,"description":7,"createdAt":42,"updatedAt":42},"健體運動",{"id":48,"attributes":49},6,{"name":50,"slug":5,"description":7,"createdAt":51,"updatedAt":51},"活學營養","2023-02-12T02:38:55.947Z",{"id":10,"attributes":53},{"name":54,"slug":55,"description":7,"createdAt":56,"updatedAt":57},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"id":59,"attributes":60},8,{"name":61,"slug":62,"description":7,"createdAt":63,"updatedAt":63},"每周恆常活動","weekly_activity","2025-12-23T03:48:29.472Z"],"uses":{"dependencies":["http://127.0.0.1:1337/api/categories?","http://127.0.0.1:1337/api/event-categories?"]},"slash":"always"},{"type":"data","data":[{"data":1,"meta":193},[2,22,40,60,76,90,108,122,137,151,165,179],{"id":3,"attributes":4},65,{"title":5,"content":6,"start_date":7,"excerpt":8,"slug":9,"end_date":10,"tags":11,"createdAt":12,"updatedAt":12,"event_categories":13,"image":21},"周末郊遊鬆一鬆:古蹟石橋- 香港仔水塘","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我地由金鐘出發，沿灣仔峽道道上山，經過警隊博物館，再徐徐下山往香港仔終點。\u003Cbr\u003E\n香港仔水塘於1931年落成，內有四項法定古蹟：上水塘的大壩、大壩石橋、壩上的水掣泵房、下水塘的大壩。\u003Cbr\u003E\n行完山，一齊在香港仔食埋晏歎埋茶先走！\u003Cbr\u003E\n今次登山路線：灣仔峽道-\u003E寶雲道-\u003E警隊博物館-\u003E香港仔水塘（預計行山時間為2小時）\u003Cbr\u003E\n備註：輕鬆易走，除了前段上山有段長命斜\u003Cbr\u003E\n日期：10\u002F11\u002F2018 星期六\u003Cbr\u003E\n時間：9:30-14:30\u003Cbr\u003E\n集合地點：金鐘地鐵站F出口，太古廣場第三期，電梯上地面的出口地面等！（9:30，不見即散）","2018-11-10","","hiking1811",null,"香港仔水塘","2018-11-10T00:00:00.000Z",{"data":14},[15],{"id":16,"attributes":17},4,{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"data":10},{"id":23,"attributes":24},68,{"title":25,"content":26,"start_date":27,"excerpt":8,"slug":28,"end_date":10,"tags":29,"createdAt":30,"updatedAt":30,"event_categories":31,"image":39},"讀書會 - 主題：經濟·商業","\n\n經濟及商業模式在過去十多年經歷翻天覆地的變化。要探討當中的經濟發展規律及經濟現象成因，離不開剖析社會、政治與民族文化。\u003Cbr\u003E\n是次讀書會以\"經濟·商業\"出發，不僅希望藉閱讀與分享，讓我們加強掌握經邦濟世之道，更希望多方面探索世界，對大環境趨勢加深理解。\u003Cbr\u003E\n誠邀各位一起閱讀，交流討論，集思廣益，共同學習，共同進步！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：12位\u003Cbr\u003E\n日期：3\u002F11\u002F2018 (星期六)\u003Cbr\u003E\n時間：14:30-16:30\u003Cbr\u003E\n地點：Coffee Lover (觀塘偉業街171號偉業工業大廈3\u002FF B室)\u003Cbr\u003E\n牛頭角MTR B出口，悅景海景酒店側\u003Cbr\u003E\n費用：$70 (包1杯飲品及小食)\u003Cbr\u003E\n名額：16人","2018-11-03","bookshare1811","商業經濟","2018-11-03T00:00:00.000Z",{"data":32},[33],{"id":34,"attributes":35},1,{"name":36,"slug":37,"description":10,"createdAt":38,"updatedAt":38},"讀書會","book-sharing","2023-02-12T02:38:55.939Z",{"data":10},{"id":41,"attributes":42},69,{"title":43,"content":44,"start_date":45,"excerpt":46,"slug":47,"end_date":10,"tags":48,"createdAt":49,"updatedAt":49,"event_categories":50,"image":59},"領導才能與團隊精神","\n\n名人面對面：領導才能與團隊精神\u003Cbr\u003E\n主講嘉賓：香港警務處榮休處長李明逵先生","2018-10-27","香港警務處榮休處長李明逵先生","dick-lee","領導力,團隊精神","2018-10-27T00:00:00.000Z",{"data":51},[52],{"id":53,"attributes":54},2,{"name":55,"slug":56,"description":10,"createdAt":57,"updatedAt":58},"名人面對面","be-our-guest","2023-02-12T02:38:55.942Z","2023-03-08T13:16:12.875Z",{"data":10},{"id":61,"attributes":62},60,{"title":10,"content":63,"start_date":64,"excerpt":8,"slug":65,"end_date":10,"tags":66,"createdAt":67,"updatedAt":67,"event_categories":68,"image":75},"\n\n想告別肚腩及手臂ByeBye肉？一於動起來，齊齊塑造理想身型！XS Keep Fit消脂班針對平日無運動習慣的朋友，循序漸進由基礎起步，讓大家起動💥\n\nTabata - 全身性運動，簡單有效的肌力訓練配合心肺功能訓練，塑造理想身型！\n\n日期：2018年10月22日（星期一）\u003Cbr\u003E\n時間：11:00-12:30\u003Cbr\u003E\n地點：旺角家樂坊15樓安利體驗館B室\u003Cbr\u003E\n費用 : $50 （自備瑜珈墊）(若需提供瑜珈墊需另加$10)","2018-10-22","xskeepfitworkshop","Tabata,肌肉鍛鍊","2018-10-22T00:00:00.000Z",{"data":69},[70],{"id":71,"attributes":72},5,{"name":73,"slug":74,"description":10,"createdAt":20,"updatedAt":20},"健體運動","fitness",{"data":10},{"id":77,"attributes":78},76,{"title":79,"content":80,"start_date":81,"excerpt":8,"slug":82,"end_date":10,"tags":83,"createdAt":84,"updatedAt":84,"event_categories":85,"image":89},"XS Keep Fit 工作坊","\n\n想告別肚腩及手臂ByeBye肉？一於動起來，齊齊塑造理想身型！\u003Cbr\u003E\nXS Keep Fit消脂班針對平日無運動習慣的朋友，循序漸進由基礎起步，讓大家起動💥\u003Cbr\u003E\nTabata - 全身性運動，簡單有效的肌力訓練配合心肺功能訓練，塑造理想身型！\u003Cbr\u003E\n日期：2018年10月15日\u003Cbr\u003E\n時間：下午2:30-4:00\u003Cbr\u003E\n地點：旺角登打士街家樂坊安利體驗館15樓C室\u003Cbr\u003E\n費用：$50\u003Cbr\u003E\n備註：請自備瑜珈墊及水樽（現場有飲用水提供）\u003Cbr\u003E\n*若需借用瑜珈墊，可以$10租用一張，但必須事先通知。","2018-10-15","keepfitworkshop1810","肌肉鍛錬,Tabata","2018-10-15T00:00:00.000Z",{"data":86},[87],{"id":71,"attributes":88},{"name":73,"slug":74,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":91,"attributes":92},64,{"title":93,"content":94,"start_date":95,"excerpt":8,"slug":96,"end_date":10,"tags":97,"createdAt":98,"updatedAt":98,"event_categories":99,"image":107},"「數碼敦煌—天上人間的故事","\n\n此乃香港文化博物館本年度的重點展覽，展品逾100件，包括首次在香港展出、建於西魏時期而極具代表性的莫高窟285窟，按1:1比例複製，重現洞內的壁畫和塑像，還有以數碼技術展現的莫高窟61窟的五代時期大型壁畫《五臺山圖》，以及都督夫人禮佛圖、勞度叉鬥聖變、彌勒下生經變、各國王子聽法圖等；亦有各時代的精美飛天、藻井圖案，全方位展現敦煌的歷史、文化與藝術。\n\nEmpower 榮幸邀得深諳敦煌歷史文化的李婉賢女士(Rosa)任嘉賓導賞，帶領一眾 Empower 友好深入認識敦煌，細味佛國世界與平凡眾生的故事。\n\n日期：2018年10月14日(星期日)\u003Cbr\u003E\n時間：上午10時 (博物館於上午10時開館)\u003Cbr\u003E\n地點：新界沙田文林路1號香港文化博物館大堂\u003Cbr\u003E\n門券：$10 (持博物館通行證免費入場)\u003Cbr\u003E\n名額：35人\u003Cbr\u003E\n午膳時間：12:45-14:00 (自費用膳)\u003Cbr\u003E\n鼓勵大家留下一起午膳，互相交流","2018-10-14","cultural1810","數碼敦煌","2018-10-14T00:00:00.000Z",{"data":100},[101],{"id":102,"attributes":103},3,{"name":104,"slug":105,"description":10,"createdAt":106,"updatedAt":106},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"data":10},{"id":109,"attributes":110},61,{"title":111,"content":112,"start_date":113,"excerpt":8,"slug":114,"end_date":10,"tags":115,"createdAt":116,"updatedAt":116,"event_categories":117,"image":121},"週末郊遊鬆一鬆：香港郊野十景之一「河背水塘」","\n\n平時侷促在辦公室及煩囂市區，放假一於逃離市區抖抖氣！\u003Cbr\u003E\n今次我們會漫步往曾獲選為香港十景之一的河背水塘。沿途景色開揚，俯瞰錦田八鄉並遠眺元朗市中心。\u003Cbr\u003E\n行完山，一齊食埋晏先走！\u003Cbr\u003E\n預計行山時間為2.5小時。\u003Cbr\u003E\n備註：沿途以平路及林蔭山徑為主，河背村附近一段是斜路。\u003Cbr\u003E\n日期：13\u002F10\u002F2018 星期日\u003Cbr\u003E\n集合時間：上午9:30，不見即散 (若不午餐，預計13:00到河背村坐小巴到元朗市中心)\u003Cbr\u003E\n集合地點：西鐵錦上路站C出口集合 (前往坐71號小巴或的的士)\u003Cbr\u003E\n路線： 河背村-\u003E河背水塘-\u003E河背村\u003Cbr\u003E\n午餐暫定13:45-15:00，於元朗某家酒樓，地點稍後確定。\u003Cbr\u003E\n若不午餐，請報名時註明。","2018-10-13","hiking1810","河背水塘","2018-10-13T00:00:00.000Z",{"data":118},[119],{"id":16,"attributes":120},{"name":18,"slug":19,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"id":123,"attributes":124},57,{"title":125,"content":126,"start_date":127,"excerpt":128,"slug":129,"end_date":10,"tags":130,"createdAt":131,"updatedAt":131,"event_categories":132,"image":136},"飛鷹媽媽‧三半人‧再生勇士鄧英蘭","\n\n日期：2018年9月9日(\b日)\u003Cbr\u003E\n時間：晚上7：15 - 9：30\u003Cbr\u003E\n地點：旺角登打士街56號家樂坊15樓安利體驗館會議室B\u003Cbr\u003E\n費用：$90一位 (包三文治及飲品)","2018-09-09","鄧英蘭女士","ms-tang","再生勇士","2018-09-09T00:00:00.000Z",{"data":133},[134],{"id":53,"attributes":135},{"name":55,"slug":56,"description":10,"createdAt":57,"updatedAt":58},{"data":10},{"id":138,"attributes":139},67,{"title":140,"content":141,"start_date":142,"excerpt":8,"slug":143,"end_date":10,"tags":144,"createdAt":145,"updatedAt":145,"event_categories":146,"image":150},"讀書會-主題：人物傳記","\n\n「以銅爲鑒，可正衣冠；以古爲鑒，可知興替；以人爲鑒，可明得失。」\u003Cbr\u003E\n生命影響生命，今次讀書會，我們將分享傳記類書籍。透過別人獨到的經歷，以人為鑒，啟迪智慧與心靈。\u003Cbr\u003E\n誠邀你一起分享閱讀體驗，一同感受由文字所帶出的美妙世界。\u003Cbr\u003E\n歡迎大家，一起閱讀、一起分享、互相啟發！\u003Cbr\u003E\n說書人：4位 (每位15分鐘)\u003Cbr\u003E\n愛書人：10位\u003Cbr\u003E\n備註：分享書籍的朋友，請於1\u002F9或之前通知我們書名及作者，最好有網址連結讓我們大約知道書本內容，讓分享會更順暢進行\u003Cbr\u003E\n日期：8\u002F9\u002F2017 (星期六)\u003Cbr\u003E\n時間：14:15-16:30\u003Cbr\u003E\n地點：咖啡綠茶＠旺角西洋菜南街38-40號萬高商業大廈3樓\u003Cbr\u003E\n費用：自費在餐廳點餐\u002F飲品\u003Cbr\u003E\n名額：14人\u003Cbr\u003E\n備註：以網站報名為準，我們將會回覆閣下的報名登記","2018-09-08","booksharing1809","人物傳記","2018-09-08T00:00:00.000Z",{"data":147},[148],{"id":34,"attributes":149},{"name":36,"slug":37,"description":10,"createdAt":38,"updatedAt":38},{"data":10},{"id":152,"attributes":153},66,{"title":154,"content":155,"start_date":156,"excerpt":8,"slug":157,"end_date":10,"tags":158,"createdAt":159,"updatedAt":159,"event_categories":160,"image":164},"香港土地供應，何去何從？","\n\n分享嘉賓：葉文祺先生 Ryan\u003Cbr\u003E\n－團結香港基金高級研究員，專攻香港土地及房屋政策\u003Cbr\u003E\n－曾任職於香港金融管理局及仲量聯行\n\n分享重點：\u003Cbr\u003E\n－香港土地供需為何嚴重失衡？如何解決困境？\u003Cbr\u003E\n－政府的需求管理措施對市場有甚麼影響？\n\n日期：2018年8月10日(\b五)\u003Cbr\u003E\n時間：晚上7：15 - 9：30\u003Cbr\u003E\n地點：旺角登打士街56號柏裕商業中心15樓安利體驗館會議室A\u003Cbr\u003E\n費用：$90一位\u002F$230三位 (包三文治及飲品)\u003Cbr\u003E\n備註：必須於網站報名，我們將於收到報名後聯絡閣下以作確認","2018-08-10","ryan-yip","香港樓市,土地供應","2018-08-10T00:00:00.000Z",{"data":161},[162],{"id":53,"attributes":163},{"name":55,"slug":56,"description":10,"createdAt":57,"updatedAt":58},{"data":10},{"id":166,"attributes":167},53,{"title":168,"content":169,"start_date":170,"excerpt":8,"slug":171,"end_date":10,"tags":172,"createdAt":173,"updatedAt":173,"event_categories":174,"image":178},"文化導賞: 奢華世代：從亞述到亞歷山大","\n\n由亞述青銅器、腓尼基象牙、巴比倫石器、阿契美尼德黃金，到希臘玻璃，這些價值連城的寶物，盡現古代中東文明的奢華風尚。\u003Cbr\u003E\n大英博物館以香港作為是次全球巡展的首站，展出逾200件橫跨公元前900年至300年的生活奢侈品。\u003Cbr\u003E\nEmpower 將安排導賞團，讓大家窺探從前的有錢人過着怎樣奢華的生活，了解背後的文化底蘊，並反思生活的意義。\n\n日期：2018年8月5日\u003Cbr\u003E\n時間：上午10:05 (博物館上午10時開館)\u003Cbr\u003E\n地點：尖沙咀漆咸道南100號香港歷史博物館大堂\u003Cbr\u003E\n門券：$10 (持博物館通行證免費入場)\u003Cbr\u003E\n名額：20人\u003Cbr\u003E\n午飯時間：11:30-12:30 (自費用膳)\u003Cbr\u003E\n鼓勵大家留下一起午膳，互相交流","2018-08-05","cultural1808","奢華世代,歷史","2018-08-05T00:00:00.000Z",{"data":175},[176],{"id":102,"attributes":177},{"name":104,"slug":105,"description":10,"createdAt":106,"updatedAt":106},{"data":10},{"id":180,"attributes":181},62,{"title":182,"content":183,"start_date":184,"excerpt":8,"slug":185,"end_date":10,"tags":186,"createdAt":187,"updatedAt":187,"event_categories":188,"image":192},"周末鬆一鬆：保齡球同樂","\n\n日期：2018年8月4日(六)\u003Cbr\u003E\n時間：上午10：30-12：30\u003Cbr\u003E\n地點：荃灣灣景花園保齡球場\u003Cbr\u003E\n費用：$85\u002F位(包括租用一對保齡球鞋費用)\u003Cbr\u003E\n備註：報名以網站報名為準，我們將會與閣下聯絡確認報名\u003Cbr\u003E\n打完保齡，一齊食午餐交流，費用自付，時間預計12：30-13：30","2018-08-04","bowling1808","保齡球","2018-08-04T00:00:00.000Z",{"data":189},[190],{"id":71,"attributes":191},{"name":73,"slug":74,"description":10,"createdAt":20,"updatedAt":20},{"data":10},{"pagination":194},{"page":195,"pageSize":195,"pageCount":196,"total":197},12,18,216],"uses":{"dependencies":["http://127.0.0.1:1337/api/events?sort=start_date%3Adesc&populate[author]=true&populate[event_categories]=true&populate[image]=true&pagination[page]=12&pagination[pageSize]=12"],"params":["page","category"]}}]}