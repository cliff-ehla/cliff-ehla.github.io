 2024-09-14 at 4.04.58 PM.png",302.79,{"ext":30,"url":141,"hash":142,"mime":33,"name":143,"path":8,"size":144,"width":56,"height":57},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fthumbnail_Screenshot_2024_09_14_at_4_04_58_PM_b3706a0b14.png","thumbnail_Screenshot_2024_09_14_at_4_04_58_PM_b3706a0b14","thumbnail_Screenshot 2024-09-14 at 4.04.58 PM.png",42,"Screenshot_2024_09_14_at_4_04_58_PM_b3706a0b14",320.22,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002FScreenshot_2024_09_14_at_4_04_58_PM_b3706a0b14.png","2024-09-14T08:23:19.324Z",{"id":150,"attributes":151},189,{"title":152,"content":153,"start_date":154,"excerpt":8,"slug":155,"end_date":154,"tags":156,"createdAt":157,"updatedAt":158,"event_categories":159,"image":167},"復活郊遊鬆一鬆：砵甸乍山 — 大浪灣","\u003Cp\u003E復活郊遊鬆一鬆：砵甸乍山 — 大浪灣\u003C\u002Fp\u003E\u003Cp\u003E復活節，一於朝氣勃勃地在小西灣的龍躍徑起步，龍年大家都龍騰虎躍。\u003C\u002Fp\u003E\u003Cp\u003E由龍躍徑起步，沿砵甸乍山郊遊徑到大浪灣，沿途180度無敵海景， 鳥瞰柴灣、小西灣、石澳、大浪灣風景。\u003C\u002Fp\u003E\u003Cp\u003E初段是一段修葺良好的梯級，大約攀升約80米後，路開始沒那麼斜，到達砵甸山觀景台後會經過一段較為平坦的山路，然後開始下山。\u003C\u002Fp\u003E\u003Cp\u003E行完山，一齊前往筲箕灣食埋晏先走！\u003C\u002Fp\u003E\u003Cp\u003E今次登山路線：小西灣海濱花園 》龍躍徑》 砵甸乍山觀景台 》 大浪灣\u003Cbr\u003E（預計行山時間為2小時）\u003Cbr\u003E備註：初段梯級\u003C\u002Fp\u003E\u003Cp\u003E日期：30\u002F3\u002F2024 星期六\u003Cbr\u003E時間：9:45-14:30\u003Cbr\u003E（預計12:00到大浪灣，大約12:45坐車到達筲箕灣）\u003Cbr\u003E集合地點：09:45小西灣南灣半島巴士總站\u003Cbr\u003E（乘車資訊：\u003Cbr\u003Ehttps:\u002F\u002Fzh.m.wikipedia.org\u002Fwiki\u002F小西灣（藍灣半島）公共運輸交匯處 ）\u003C\u002Fp\u003E","2024-03-30","event-1","行山","2024-03-21T09:04:21.343Z","2024-03-21T09:08:15.935Z",{"data":160},[161],{"id":162,"attributes":163},4,{"name":164,"slug":165,"description":8,"createdAt":166,"updatedAt":166},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"data":168},{"id":169,"attributes":170},41,{"name":171,"alternativeText":8,"caption":8,"width":26,"height":172,"formats":173,"hash":198,"ext":30,"mime":33,"size":199,"url":200,"previewUrl":8,"provider":61,"provider_metadata":8,"createdAt":201,"updatedAt":201},"Screenshot 2024-02-28 at 3.34.27 PM.png",1730,{"large":174,"small":180,"medium":186,"thumbnail":192},{"ext":30,"url":175,"hash":176,"mime":33,"name":177,"path":8,"size":178,"width":36,"height":179},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b.png","large_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b","large_Screenshot 2024-02-28 at 3.34.27 PM.png",599.47,721,{"ext":30,"url":181,"hash":182,"mime":33,"name":183,"path":8,"size":184,"width":43,"height":185},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b.png","small_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b","small_Screenshot 2024-02-28 at 3.34.27 PM.png",171.37,360,{"ext":30,"url":187,"hash":188,"mime":33,"name":189,"path":8,"size":190,"width":37,"height":191},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fmedium_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b.png","medium_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b","medium_Screenshot 2024-02-28 at 3.34.27 PM.png",355.77,541,{"ext":30,"url":193,"hash":194,"mime":33,"name":195,"path":8,"size":196,"width":197,"height":57},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fthumbnail_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b.png","thumbnail_Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b","thumbnail_Screenshot 2024-02-28 at 3.34.27 PM.png",43.43,216,"Screenshot_2024_02_28_at_3_34_27_PM_a603a33b6b",645.79,"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002FScreenshot_2024_02_28_at_3_34_27_PM_a603a33b6b.png","2024-03-21T09:03:42.795Z",{"id":203,"attributes":204},188,{"title":205,"content":206,"start_date":207,"excerpt":8,"slug":208,"end_date":207,"tags":156,"createdAt":209,"updatedAt":210,"event_categories":211,"image":215},"龍年新春行大運：步步高升 — 山頂西高山","\u003Cp\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E龍年新春行大運\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E步步高升 — 山頂西高山\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E我地由山頂出發，步步高升走樓梯上西高山，沿途飽覽薄扶林水塘、數碼港，並遠眺南丫島，登頂後更可一覽無遺地觀賞維港兩岸景色。\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E下山時尋找維多利亞城界石及松林炮台遺址 — 松林廢堡。\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E行完山，一齊去西營盤食埋晏歎埋茶先走！\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E今次登山路線：山頂 › 西高山 › 松林廢堡 › 香港大學（預計行山時間：2.5小時）\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E日期：12\u002F2\u002F2024 （年初三）\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E時間：9:30-14:30&nbsp;\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E集合地點：中環站A出口（閘外附近，9:30集合）\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E前往交易廣場坐15號巴士到山頂\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E預計13:00到西營盤午餐\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E預計食晏時間：13:00-14:30\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003E備註：登上西高山途中有較多石級\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\"color:rgb(0,0,0);font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, &quot;Noto Sans&quot;, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;;\"\u003E報名：請傳電郵到empowerhkinfo@gmail.com 或 在 Facebook.com\u002Fempower.hk 給我們Messanger 訊息。謝謝！\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cspan style=\"background-color:rgb(255,255,255);color:rgb(5,5,5);font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;.SFNSText-Regular&quot;, sans-serif;\"\u003EPowered by Empower\u003C\u002Fspan\u003E\u003Cbr\u003E\u003Ca href=\"https:\u002F\u002Fl.facebook.com\u002Fl.php?u=http%3A%2F%2Fwww.Empower.hk%2F%3Ffbclid%3DIwAR29r2i7uhcjB-qIjj7pxxwGMr4KH5bU0iG1TYL0V46fm4Bl0g0YHjHlPhY&amp;h=AT2IZv7rvRPueHjxVcIfNj8PdQr_zoke88Jx7ZTIpnGbEkdZBLQQf0krvZW