003Cp\u003E古蹟文化遊 - 屏山文物徑\u003C\u002Fp\u003E\u003Cp\u003E今次我們漫遊元朗古村落，走訪香港首條文物徑 — 屏山文物徑，細味中國傳統建築。\u003Cbr\u003E漫步後，一同享用廣東傳統美食「九大簋」，感受傳統節日美食文化！\u003C\u002Fp\u003E\u003Cp\u003E今次郊遊路線：屏山天水圍圖書館(有全港最美圖書館之美譽)→屏山鄧族(三圍六村)\u002F文物徑：聚星樓→達德公所→上璋圍→坑頭村→鄧氏宗祠→屏山鄧族文物館→九大簋午餐（預計時間為2小時）\u003Cbr\u003E🌟 歷史學家蘇銳鴻校長專業導賞\u003C\u002Fp\u003E\u003Cp\u003E日期：10\u002F1\u002F2026 星期六\u003Cbr\u003E時間：9:30-14:00&nbsp;\u003Cbr\u003E（若不午餐，12:00解散）\u003Cbr\u003E集合地點：9:30港鐵屯馬綫天水圍站D出口出閘後\u003Cbr\u003E午餐費用：$238，必須預先繳費留座\u003Cbr\u003E備註：路面平坦易行\u003C\u002Fp\u003E\u003Cp\u003EPowered by Empower&nbsp;\u003Cbr\u003Ewww.empower.hk\u003Cbr\u003EFacebook.com\u002Fempower.hk\u003C\u002Fp\u003E","2026-01-10",null,"Ping-Shan-Heritage-Trail-260110","2025-12-23T03:41:48.906Z",{"data":10},[11,17],{"id":12,"attributes":13},3,{"name":14,"slug":15,"description":6,"createdAt":16,"updatedAt":16},"文化導賞","cultural","2023-02-12T02:38:55.943Z",{"id":18,"attributes":19},4,{"name":20,"slug":21,"description":6,"createdAt":22,"updatedAt":22},"遊山玩水","hiking","2023-02-12T02:38:55.946Z",{"data":24},{"id":25,"attributes":26},84,{"name":27,"alternativeText":6,"caption":6,"width":28,"height":29,"formats":30,"hash":61,"ext":32,"mime":35,"size":62,"url":63,"previewUrl":6,"provider":64,"provider_metadata":6,"createdAt":65,"updatedAt":65},"1a.jpeg",1600,1146,{"large":31,"small":40,"medium":47,"thumbnail":54},{"ext":32,"url":33,"hash":34,"mime":35,"name":36,"path":6,"size":37,"width":38,"height":39},".jpeg","https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Flarge_1a_5da3c1581a.jpeg","large_1a_5da3c1581a","image\u002Fjpeg","large_1a.jpeg",125.87,1000,716,{"ext":32,"url":41,"hash":42,"mime":35,"name":43,"path":6,"size":44,"width":45,"height":46},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaws.com\u002Fsmall_1a_5da3c1581a.jpeg","small_1a_5da3c1581a","small_1a.jpeg",43.6,500,358,{"ext":32,"url":48,"hash":49,"mime":35,"name":50,"path":6,"size":51,"width":52,"height":53},"https:\u002F\u002Fempowerhk.s3.ap-southeast-1.amazonaw